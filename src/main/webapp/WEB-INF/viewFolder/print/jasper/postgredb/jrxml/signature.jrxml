		</box>
	</style>
	<style name="table_TD" mode="Opaque" backcolor="#FFFFFF">
		<box>
			<pen lineWidth="0.5" lineColor="#000000"/>
		</box>
	</style>
	<subDataset name="dataSet1">
		<parameter name="P_COMPANY_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_PARAM1" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_PARAM2" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_PARAM3" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_SERVER_URL" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT DENSE_RANK() OVER(ORDER BY APPOINT_REASON, USER_NAME) AS SEQ
      ,PRODUCT_LINE
      ,DEPARTMENT_NAME
      ,EMP_NO
      ,USER_NAME
      ,POSITION_NAME
      ,START_DATE
      ,APPOINT_REASON
      ,END_DATE
      ,CANCEL_REASON
      ,SIGN_FULL_FILE
FROM   (SELECT SI.PRODUCT_LINE
              ,SI.DEPARTMENT_NAME
              ,SI.EMP_NO
              ,SI.SIGNATURE_NAME  USER_NAME
              ,SI.POSITION        AS POSITION_NAME
              ,$P{P_SERVER_URL} || MAX(SI.SIGN_FILE_PATH) || MAX(SI.SIGN_FILE_NAME) AS SIGN_FULL_FILE
              ,TO_CHAR(TO_DATE(MAX(SI.START_DATE), 'YYYYMMDD'), 'YYYY-MM-DD') AS START_DATE
              ,MAX(SI.REMARK) AS APPOINT_REASON
              ,TO_CHAR(TO_DATE(MAX(SI.END_DATE), 'YYYYMMDD'), 'YYYY-MM-DD') AS END_DATE
              ,MAX(SI.REMARK) AS CANCEL_REASON
        FROM   SIGNATURE SI
        WHERE  SI.COMPANY_CODE = $P{P_COMPANY_CODE}
        AND    DECODE($P{P_PARAM1}, 'true', SI.END_DATE, NULL) IS NULL
        AND    NVL2($P{P_PARAM3}, DECODE($P{P_PARAM2}, 'USER', SI.SIGNATURE_NAME, 'EMP_NO', SI.EMP_NO), 1) LIKE
               '%' || NVL($P{P_PARAM3}, 1) || '%'
        GROUP  BY SI.PRODUCT_LINE
                 ,SI.DEPARTMENT_NAME
                 ,SI.EMP_NO
                 ,SI.SIGNATURE_NAME
                 ,SI.POSITION)
ORDER  BY APPOINT_REASON
         ,USER_NAME]]>
		</queryString>
		<field name="SEQ" class="java.math.BigDecimal"/>
		<field name="PRODUCT_LINE" class="java.lang.String"/>
		<field name="DEPARTMENT_NAME" class="java.lang.String"/>
		<field name="EMP_NO" class="java.lang.String"/>
		<field name="USER_NAME" class="java.lang.String"/>
		<field name="POSITION_NAME" class="java.lang.String"/>
		<field name="SIGN_FULL_FILE" class="java.lang.String"/>
		<field name="APPOINT_REASON" class="java.lang.String"/>
		<field name="CANCEL_REASON" class="java.lang.String"/>
		<field name="START_DATE" class="java.lang.String"/>
		<field name="END_DATE" class="java.lang.String"/>
	</subDataset>
	<parameter name="P_COMPANY_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_PARAM1" class="java.lang.String"/>
	<parameter name="P_PARAM2" class="java.lang.String"/>
	<parameter name="P_PARAM3" class="java.lang.String"/>
	<parameter name="P_SERVER_URL" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT COMPANY_CODE
  FROM SIGNATURE SI
 WHERE ROWNUM = 1]]>
	</queryString>
	<field name="COMPANY_CODE" class="java.lang.String"/>
