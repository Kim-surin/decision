	<subDataset name="dataset 1" uuid="e5342826-df19-45f9-954a-11a0a81e74d1">
		<parameter name="P_COO_CERTIFY_NO" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_SALES_NO" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_DIVISION_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_COMPANY_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_FTA_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_SALES_SEQ" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
<![CDATA[
SELECT item_name
     , item_code
     , item_pull_name
     , item_hs_code
     , origin
     , qty
     , amount
     , maker_name
FROM (
    SELECT im.item_name
         , fcr_dtl.item_code
         , CASE
               WHEN sd.customer_item_code IS NOT NULL THEN sd.customer_item_code || '/'
               ELSE ''
           END || im.item_name || '/' || fcr_dtl.item_code AS item_pull_name
         , SUBSTR(fcr_dtl.hs_code, 1, 6) AS item_hs_code
         , CASE
               WHEN du.flag = 'IN' THEN '역내'
               ELSE '비역내'
           END AS origin
         , CASE
               WHEN du.flag = 'IN' THEN fcr_dtl.inarea_qty
               ELSE fcr_dtl.outarea_qty
           END AS qty
         , CASE
               WHEN du.flag = 'IN' THEN fcr_dtl.inarea_amount
               ELSE fcr_dtl.outarea_amount
           END AS amount
         , (
               SELECT poledger.maker_name
               FROM po_ledger poledger
               WHERE poledger.item_code = fcr_dtl.item_code
                 AND poledger.company_code = fcr_dtl.company_code
                 AND poledger.warehousing_date <= sm.invoice_date
               ORDER BY poledger.warehousing_date DESC
               LIMIT 1
           ) AS maker_name
    FROM coo_fcr_mst fcr_mst
    INNER JOIN coo_fcr_dtl fcr_dtl
            ON fcr_mst.fta_code = fcr_dtl.fta_code
           AND fcr_mst.sales_no = fcr_dtl.sales_no
           AND fcr_mst.sales_seq = fcr_dtl.sales_seq
           AND fcr_mst.division_code = fcr_dtl.division_code
           AND fcr_mst.company_code = fcr_dtl.company_code
           AND fcr_mst.coo_certify_no = fcr_dtl.coo_certify_no
    INNER JOIN item_mst im
            ON im.item_code = fcr_dtl.item_code
           AND im.company_code = fcr_dtl.company_code
    INNER JOIN coo_certify_ledger ledger
            ON fcr_mst.division_code = ledger.division_code
           AND fcr_mst.company_code = ledger.company_code
           AND fcr_mst.coo_certify_no = ledger.coo_certify_no
    INNER JOIN sales_dtl_v sd
            ON fcr_mst.sales_no = sd.sales_no
           AND fcr_mst.sales_seq = sd.sales_seq
           AND fcr_mst.division_code = sd.division_code
           AND fcr_mst.company_code = sd.company_code
    INNER JOIN sales_mst_v sm
            ON fcr_mst.sales_no = sm.sales_no
           AND fcr_mst.division_code = sm.division_code
           AND fcr_mst.company_code = sm.company_code
    INNER JOIN (
        SELECT 'IN' AS flag
        UNION ALL
        SELECT 'OUT' AS flag
    ) du
            ON 1 = 1
    WHERE fcr_mst.sales_no = $P{P_SALES_NO}
      AND fcr_mst.division_code = $P{P_DIVISION_CODE}
      AND fcr_mst.company_code = $P{P_COMPANY_CODE}
      AND fcr_mst.sales_seq = $P{P_SALES_SEQ}
      AND fcr_mst.fta_code = $P{P_FTA_CODE}
      AND fcr_mst.coo_certify_no = $P{P_COO_CERTIFY_NO}
    ORDER BY item_name, flag
) t
WHERE qty <> 0
   OR amount <> 0
]]>
</queryString>
		<field name="ITEM_NAME" class="java.lang.String"/>
		<field name="ITEM_CODE" class="java.lang.String"/>
		<field name="ITEM_PULL_NAME" class="java.lang.String"/>
		<field name="ITEM_HS_CODE" class="java.lang.String"/>
		<field name="ORIGIN" class="java.lang.String"/>
		<field name="QTY" class="java.math.BigDecimal"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
		<field name="MAKER_NAME" class="java.lang.String"/>
	</subDataset>
	<parameter name="P_COMPANY_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DIVISION_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COO_CERTIFY_NO" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_SERVER_URL" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
<![CDATA[
SELECT fm.sales_no
     , fm.sales_seq
     , fm.fta_code
     , CASE
           WHEN sm.export_flag = 'E'
               THEN MAX(COALESCE(d.division_full_name, sm.producer_name))
           ELSE MAX(COALESCE(sm.exporter_name, cu.customer_name))
       END AS exporter_name
     , CASE
           WHEN sm.export_flag = 'E'
               THEN MAX(COALESCE(co.officer_name, sm.producer_representative_name))
           ELSE MAX(COALESCE(sm.exporter_representative_name, cu.officer_name))
       END AS exporter_representative_name
     , CASE
           WHEN sm.export_flag = 'E'
               THEN MAX(COALESCE(d.business_no, sm.producer_biz_no))
           ELSE MAX(COALESCE(cu.business_no, sm.exporter_biz_no))
       END AS exporter_biz_no
     , CASE
           WHEN sm.export_flag = 'E'
               THEN MAX(COALESCE(co.com_phone_no || ' / ' || co.com_fax_no, sm.producer_tel_no))
           ELSE MAX(COALESCE(cu.tel_no || ' / ' || cu.fax_no, sm.exporter_tel_no))
       END AS exporter_tel_no
     , CASE
           WHEN sm.export_flag = 'E'
               THEN MAX(COALESCE(d.address, sm.producer_address))
           ELSE MAX(COALESCE(cu.address, sm.exporter_address))
       END AS exporter_address
     , MAX(COALESCE(d.division_full_name, sm.producer_name)) AS producer_name
     , MAX(COALESCE(co.officer_name, sm.producer_representative_name)) AS producer_representative_name
     , MAX(COALESCE(d.business_no, sm.producer_biz_no)) AS producer_biz_no
     , MAX(COALESCE(sm.producer_tel_no, co.com_phone_no || ' / ' || co.com_fax_no)) AS producer_tel_no
     , MAX(COALESCE(sm.producer_address, co.address)) AS producer_address
     , sd.product_name
       || CASE WHEN im.spec IS NOT NULL THEN ' (' || im.spec || '), ' ELSE ', ' END
       || sd.product_code AS product_name
     , SUBSTR(fm.hs_code, 1, 6) AS hs_code
     , fta.inkoterms_type
     , CASE
           WHEN fta.inkoterms_type = 'FOB' THEN fm.fob_amount
           ELSE fm.exwork_amount
       END AS amount
     , fm.rule_contents
     , fl.content
     , '▶ 뒷장참고' AS item_hs_code
     , TRUNC(fm.inarea_amount, 4) AS inarea_amount
     , TRUNC(fm.outarea_amount, 4) AS outarea_amount
     , TRUNC((fm.inarea_amount + fm.outarea_amount), 4) AS tot_sum
     , COALESCE(fr.wo_coo_yn, 'N') AS wo_yn
     , COALESCE(fr.ctc_yn, 'N') AS ctc_yn
     , COALESCE(fr.company_rvc_yn, 'N') AS rvc_yn
     , fr.rvc_result_rate AS rvc_rate
     , CASE
           WHEN fm.rule_contents LIKE '%+%' THEN 'Y'
           ELSE 'N'
       END AS ctc_rvc_yn
     , COALESCE(fr.company_de_minimis_yn, 'N') AS min_yn
     , COALESCE(fr.sp_coo_yn, 'N') AS sp_yn
     , COALESCE(fr.company_coo_yn, 'N') AS company_coo_yn
     , CASE
           WHEN TRUNC(SUM(fd.outarea_amount), 4) > 0 THEN 'N'
           ELSE 'Y'
       END AS pe_yn
     , fta.fta_name
     , si.signature_name
     , si.position
     , $P{P_SERVER_URL} || si.sign_file_path || si.sign_file_name AS sign_full_file
     , CASE
           WHEN cl.coo_type = 'N' THEN sm.invoice_date
           ELSE cl.issue_date
       END AS coo_date
FROM coo_certify_ledger cl
INNER JOIN coo_certify_ledger_dtl cd
        ON cd.coo_certify_no = cl.coo_certify_no
       AND cd.division_code = cl.division_code
       AND cd.company_code = cl.company_code
INNER JOIN sales_mst_v sm
        ON sm.sales_no = cd.sales_no
       AND sm.division_code = cd.division_code
       AND sm.company_code = cd.company_code
INNER JOIN sales_dtl_v sd
        ON sd.sales_no = cd.sales_no
       AND sd.sales_seq = cd.sales_seq
       AND sd.division_code = cd.division_code
       AND sd.company_code = cd.company_code
INNER JOIN coo_fcr_mst fm
        ON fm.sales_no = sd.sales_no
       AND fm.sales_seq = sd.sales_seq
       AND fm.company_code = sd.company_code
       AND fm.division_code = sd.division_code
       AND fm.fta_code = cd.fta_code
       AND fm.coo_certify_no = cd.coo_certify_no
LEFT OUTER JOIN coo_fcr_dtl fd
             ON fd.fta_code = fm.fta_code
            AND fd.sales_no = fm.sales_no
            AND fd.sales_seq = fm.sales_seq
            AND fd.division_code = fm.division_code
            AND fd.company_code = fm.company_code
LEFT OUTER JOIN coo_fcr_result fr
             ON fr.sales_no = fm.sales_no
            AND fr.sales_seq = fm.sales_seq
            AND fr.fta_code = fm.fta_code
            AND fr.company_code = fm.company_code
            AND fr.division_code = fm.division_code
            AND fr.rule_code = fm.rule_contents
INNER JOIN item_mst im
        ON im.item_code = cd.product_code
       AND im.company_code = cd.company_code
INNER JOIN company co
        ON co.company_code = cl.company_code
INNER JOIN division d
        ON d.division_code = cl.division_code
       AND d.company_code = cl.company_code
INNER JOIN customer cu
        ON cu.customer_code = sm.customer_code
       AND cu.company_code = sm.company_code
INNER JOIN fta_master fta
        ON fta.fta_code = fm.fta_code
LEFT OUTER JOIN signature si
             ON si.company_code = cl.company_code
            AND si.seq = cl.sign_seq
LEFT OUTER JOIN flowchart fl
             ON im.product_code = fl.flowchart_code
            AND im.company_code = fl.company_code
WHERE cl.division_code = $P{P_DIVISION_CODE}
  AND cl.company_code = $P{P_COMPANY_CODE}
  AND cl.coo_certify_no = $P{P_COO_CERTIFY_NO}
GROUP BY fm.sales_no
       , fm.sales_seq
       , sm.export_flag
       , fm.fta_code
       , sd.product_name
       , sd.product_code
       , im.spec
       , SUBSTR(fm.hs_code, 1, 6)
       , fta.inkoterms_type
       , fm.fob_amount
       , fm.exwork_amount
       , fm.rule_contents
       , fl.content
       , fr.wo_coo_yn
       , fr.ctc_yn
       , cl.coo_type
       , fr.company_rvc_yn
       , sm.invoice_date
       , cl.issue_date
       , fr.rvc_result_rate
       , fr.company_de_minimis_yn
       , fr.sp_coo_yn
       , fr.company_coo_yn
       , fta.fta_name
       , si.signature_name
       , si.position
       , si.sign_file_path
       , si.sign_file_name
       , fm.coo_date
       , fm.inarea_amount
       , fm.outarea_amount
ORDER BY fm.sales_seq
       , fm.fta_code
]]>
</queryString>
