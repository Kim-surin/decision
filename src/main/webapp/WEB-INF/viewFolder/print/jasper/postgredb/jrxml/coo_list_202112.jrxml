	<subDataset name="dataSet1" uuid="396196ba-a253-4c0b-b62f-636b596a6c99">
		<parameter name="P_COMPANY_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_DIVISION_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_COO_CERTIFY_NO" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
		<![CDATA[
		SELECT DENSE_RANK() OVER(ORDER BY fcr.product_code, fcr.sales_seq) AS num
		     , CASE
		           WHEN cm.customer_item_name IS NOT NULL THEN cm.customer_item_name || ' / '
		           ELSE ''
		       END
		       || im.item_code || ' / ' || im.item_name
		       || CASE
		              WHEN cm.customer_item_name <> im.item_code THEN ' / ' || im.item_code
		              ELSE ''
		          END AS product_name
		     , COALESCE(COALESCE(cld.customer_item_code, cm.customer_item_code), cld.product_code) AS product_code
		     , fcr.fta_code
		     , fm.fta_name
		     , SUBSTR(COALESCE(cm.customer_hs_code, fcr.hs_code), 1, 6) AS hs_code
		     , CASE
		           WHEN fcr.rule_contents IS NULL AND fcr.company_coo_yn = 'N' THEN
		                (
		                    SELECT fr.rule_contents
		                    FROM fta_rule fr
		                    WHERE fr.hs_code = SUBSTR(fcr.hs_code, 1, LENGTH(fr.hs_code))
		                      AND fr.hs_code_sub_category = '1'
		                      AND fr.fta_code = fcr.fta_code
		                    LIMIT 1
		                )
		           ELSE fcr.rule_contents
		       END AS rule_contents
		     , fcr.company_coo_yn
		     , CASE
		           WHEN fcr.company_coo_yn = 'Y' THEN 'KR'
		           ELSE ''
		       END AS origin_nation
		     , mst.apply_date
		     , mst.end_date
		     , cld.sales_seq
		FROM coo_certify_ledger mst
		INNER JOIN coo_certify_ledger_dtl cld
		        ON cld.coo_certify_no = mst.coo_certify_no
		       AND cld.division_code = mst.division_code
		       AND cld.company_code = mst.company_code
		LEFT OUTER JOIN item_mst im
		             ON im.item_code = cld.product_code
		            AND im.company_code = cld.company_code
		INNER JOIN coo_fcr_mst fcr
		        ON cld.sales_no = fcr.sales_no
		       AND cld.sales_seq = fcr.sales_seq
		       AND cld.division_code = fcr.division_code
		       AND cld.company_code = fcr.company_code
		       AND cld.fta_code = fcr.fta_code
		       AND cld.coo_certify_no = fcr.coo_certify_no
		INNER JOIN fta_master fm
		        ON fm.fta_code = fcr.fta_code
		LEFT OUTER JOIN customer_model cm
		             ON cm.item_code = cld.product_code
		            AND cm.customer_code = mst.customer_code
		            AND cm.division_code = fcr.prod_division_code
		            AND cm.company_code = mst.company_code
		WHERE mst.coo_certify_no = $P{P_COO_CERTIFY_NO}
		  AND mst.division_code = $P{P_DIVISION_CODE}
		  AND mst.company_code = $P{P_COMPANY_CODE}
		ORDER BY fcr.sales_seq
		       , COALESCE(COALESCE(cld.customer_item_code, cm.customer_item_code), cld.product_code)
		       , fcr.fta_code
		       , num
		]]>
		</queryString>
		<field name="NUM" class="java.math.BigDecimal"/>
		<field name="PRODUCT_NAME" class="java.lang.String"/>
		<field name="PRODUCT_CODE" class="java.lang.String"/>
		<field name="FTA_CODE" class="java.lang.String"/>
		<field name="FTA_NAME" class="java.lang.String"/>
		<field name="HS_CODE" class="java.lang.String"/>
		<field name="RULE_CONTENTS" class="java.lang.String"/>
		<field name="COMPANY_COO_YN" class="java.lang.String"/>
		<field name="ORIGIN_NATION" class="java.lang.String"/>
		<field name="APPLY_DATE" class="java.lang.String"/>
		<field name="END_DATE" class="java.lang.String"/>
		<field name="SALES_SEQ" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="dataSet2" uuid="a71f90bc-6d65-4b5e-9599-760d7d815043">
		<parameter name="P_COMPANY_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_DIVISION_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_COO_CERTIFY_NO" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
<![CDATA[
SELECT a.num
     , CASE
           WHEN b.fta_code IS NULL THEN ' '
           WHEN b.fta_code IS NOT NULL AND a.rcep_coo_nation = 'KR' THEN 'V'
           ELSE ' '
       END AS bd20_apply_yes
     , CASE
           WHEN b.fta_code IS NULL THEN ' '
           WHEN b.fta_code IS NOT NULL AND a.rcep_coo_nation != 'KR' THEN 'V'
           ELSE ' '
       END AS bd20_apply_no
FROM (
    SELECT DENSE_RANK() OVER(ORDER BY fcr.product_code, fcr.sales_seq) AS num
         , SUBSTR(COALESCE(cm.customer_hs_code, fcr.hs_code), 1, 6) AS hs_code
         , fcr.fta_code
         , fcrr.rcep_coo_nation
         , mst.issue_date
         , cld.product_code
    FROM coo_certify_ledger mst
    INNER JOIN coo_certify_ledger_dtl cld
            ON cld.coo_certify_no = mst.coo_certify_no
           AND cld.division_code = mst.division_code
           AND cld.company_code = mst.company_code
    INNER JOIN coo_fcr_mst fcr
            ON cld.sales_no = fcr.sales_no
           AND cld.sales_seq = fcr.sales_seq
           AND cld.division_code = fcr.division_code
           AND cld.company_code = fcr.company_code
           AND cld.fta_code = fcr.fta_code
           AND cld.coo_certify_no = fcr.coo_certify_no
    INNER JOIN fcr_mst fcrr
            ON fcrr.sales_no = fcr.sales_no
           AND fcrr.sales_seq = fcr.sales_seq
           AND fcrr.division_code = fcr.division_code
           AND fcrr.company_code = fcr.company_code
           AND fcrr.fta_code = fcr.fta_code
    LEFT OUTER JOIN customer_model cm
                 ON cm.item_code = cld.product_code
                AND cm.customer_code = mst.customer_code
                AND cm.division_code = fcr.prod_division_code
                AND cm.company_code = mst.company_code
    WHERE mst.coo_certify_no = $P{P_COO_CERTIFY_NO}
      AND mst.division_code = $P{P_DIVISION_CODE}
      AND mst.company_code = $P{P_COMPANY_CODE}
      AND fcr.fta_code = 'PKRRC'
) a
LEFT OUTER JOIN tariff_differentials b
             ON a.hs_code = b.hs_code
            AND a.fta_code = b.fta_code
            AND a.issue_date BETWEEN b.apply_date AND b.end_date
ORDER BY num
]]>
</queryString>
		<field name="NUM" class="java.math.BigDecimal"/>
		<field name="BD20_APPLY_YES" class="java.lang.String"/>
		<field name="BD20_APPLY_NO" class="java.lang.String"/>
		<group name="NUM">
			<groupExpression><![CDATA[$F{NUM}]]></groupExpression>
		</group>
		<group name="BD20_APPLY_YN">
			<groupExpression><![CDATA[]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="P_COMPANY_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DIVISION_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_COO_CERTIFY_NO" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_SERVER_URL" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
<![CDATA[
SELECT mst.coo_certify_no
     , COALESCE(REPLACE(sa_mst.exporter_name, ' ', ''), cu.customer_name) AS exporter_name
     , COALESCE(REPLACE(sa_mst.exporter_biz_no, ' ', ''), cu.business_no) AS exporter_biz_no
     , COALESCE(REPLACE(sa_mst.exporter_representative_name, ' ', ''), cu.officer_name) AS exporter_representative_name
     , COALESCE(REPLACE(sa_mst.exporter_tel_no, ' / ', ''), cu.tel_no) AS exporter_tel_no
     , COALESCE(cu.fax_no, '') AS exporter_fax_no
     , ' ' AS exporter_email
     , COALESCE(REPLACE(sa_mst.exporter_address, ' ', ''), cu.address) AS exporter_address
     , sa_mst.producer_name
     , sa_mst.producer_biz_no
     , sa_mst.producer_representative_name
     , sa_mst.producer_tel_no
     , COALESCE(co.com_fax_no, ' ') AS producer_fax_no
     , ' ' AS producer_email
     , COALESCE(sa_mst.producer_address, co.address) AS producer_address
     , CASE
           WHEN sa_mst.export_flag = 'E' THEN ui.name_eng
           ELSE sig.signature_name
       END AS signature_name
     , sig.position
     , $P{P_SERVER_URL} || sig.sign_file_path || sig.sign_file_name AS sign_file_path
     , mst.issue_date AS issue_date
     , COALESCE(d.certification_no, co.certification_no) AS certification_no
     , co.com_fax_no
     , co.officer_email
FROM coo_certify_ledger mst
INNER JOIN coo_certify_ledger_dtl cd
        ON cd.coo_certify_no = mst.coo_certify_no
       AND cd.company_code = mst.company_code
       AND cd.division_code = mst.division_code
INNER JOIN sales_mst_v sa_mst
        ON sa_mst.sales_no = cd.sales_no
       AND sa_mst.division_code = cd.division_code
       AND sa_mst.company_code = cd.company_code
INNER JOIN company co
        ON co.company_code = mst.company_code
INNER JOIN division d
        ON d.division_code = mst.division_code
       AND d.company_code = mst.company_code
INNER JOIN customer cu
        ON cu.customer_code = sa_mst.customer_code
       AND cu.company_code = sa_mst.company_code
LEFT OUTER JOIN signature sig
             ON sig.seq = mst.sign_seq
            AND sig.company_code = mst.company_code
LEFT OUTER JOIN user_info ui
             ON ui.user_id = sig.emp_no
            AND ui.company_code = sig.company_code
WHERE mst.coo_certify_no = $P{P_COO_CERTIFY_NO}
  AND mst.division_code = $P{P_DIVISION_CODE}
  AND mst.company_code = $P{P_COMPANY_CODE}
LIMIT 1
]]>
</queryString>
