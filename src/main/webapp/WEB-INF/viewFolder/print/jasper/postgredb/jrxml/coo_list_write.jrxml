	<subDataset name="dataSet1" uuid="de975a33-1a53-4f16-a246-2b4d2b48168b">
		<parameter name="P_COMPANY_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_PARAM1" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_PARAM2" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_PARAM3" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_PARAM4" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT cl.coo_certify_no
     , cl.issue_date
     , sd.export_declare_no || '/' || TO_CHAR(TO_DATE(sd.export_declare_date, 'YYYYMMDD'), 'YYYY-MM-DD') AS export_declare
     , im.item_name AS item
     , ccd.product_code
     , sd.quantity
     , sd.amount
     , CASE
           WHEN sm.export_flag = 'D' THEN sm.exporter_name
           ELSE COALESCE(c.customer_name_eng, c.customer_name)
       END AS importer
     , fm.fta_name AS arrival
     , fcr.rule_contents AS fta_name
     , CASE
           WHEN fcr.company_coo_yn = 'Y' THEN 'KR'
           ELSE '역외'
       END AS origin_nation
     , '' AS remark
FROM coo_certify_ledger cl
INNER JOIN coo_certify_ledger_dtl ccd
        ON ccd.coo_certify_no = cl.coo_certify_no
       AND ccd.division_code = cl.division_code
       AND ccd.company_code = cl.company_code
INNER JOIN sales_mst sm
        ON sm.sales_no = ccd.sales_no
       AND sm.company_code = ccd.company_code
       AND sm.division_code = ccd.division_code
INNER JOIN sales_dtl sd
        ON sd.sales_no = ccd.sales_no
       AND sd.sales_seq = ccd.sales_seq
       AND sd.company_code = ccd.company_code
       AND sd.division_code = ccd.division_code
INNER JOIN item_mst im
        ON im.item_code = ccd.product_code
       AND im.company_code = ccd.company_code
INNER JOIN customer c
        ON c.customer_code = sm.customer_code
       AND c.company_code = sm.company_code
INNER JOIN company co
        ON co.company_code = ccd.company_code
LEFT OUTER JOIN code_dtl cd
             ON cd.code = sm.arrival_nation
            AND cd.category = 'NA'
            AND cd.company_code = ccd.company_code
            AND cd.delete_yn = 'N'
INNER JOIN coo_fcr_mst fcr
        ON fcr.sales_no = ccd.sales_no
       AND fcr.sales_seq = ccd.sales_seq
       AND fcr.division_code = ccd.division_code
       AND fcr.company_code = ccd.company_code
       AND fcr.fta_code = ccd.fta_code
       AND fcr.coo_certify_no = ccd.coo_certify_no
INNER JOIN fta_master fm
        ON fm.fta_code = fcr.fta_code
       AND fm.company_code = fcr.company_code
       AND (fm.co_issue_flag = 'S' OR cl.coo_type = 'C')
WHERE cl.company_code = $P{P_COMPANY_CODE}
  AND cl.issue_date BETWEEN $P{P_PARAM1} AND $P{P_PARAM2}
ORDER BY cl.coo_certify_no]]>
		</queryString>
		<field name="COO_CERTIFY_NO" class="java.lang.String"/>
		<field name="ISSUE_DATE" class="java.lang.String"/>
		<field name="EXPORT_DECLARE" class="java.lang.String"/>
		<field name="ITEM" class="java.lang.String"/>
		<field name="PRODUCT_CODE" class="java.lang.String"/>
		<field name="QUANTITY" class="java.math.BigDecimal"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
		<field name="IMPORTER" class="java.lang.String"/>
		<field name="ARRIVAL" class="java.lang.String"/>
		<field name="FTA_NAME" class="java.lang.String"/>
		<field name="ORIGIN_NATION" class="java.lang.String"/>
		<field name="REMARK" class="java.lang.String"/>
	</subDataset>
	<parameter name="P_COMPANY_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_PARAM1" class="java.lang.String"/>
	<parameter name="P_PARAM2" class="java.lang.String"/>
	<parameter name="P_PARAM3" class="java.lang.String"/>
	<parameter name="P_PARAM4" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_PARAM5" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_PARAM6" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT COMPANY_CODE
  FROM COMPANY SI
 LIMIT 1]]>
	</queryString>
	<field name="COMPANY_CODE" class="java.lang.String"/>
