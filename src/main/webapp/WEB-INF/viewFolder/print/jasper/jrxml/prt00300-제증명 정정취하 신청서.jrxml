	<subDataset name="dataSet1" whenResourceMissingType="Empty" uuid="7bd57bec-4672-44b1-ad6e-c6047d42cb72">
		<parameter name="P_KEY_PARAM1" class="java.lang.String"/>
		<parameter name="P_KEY_PARAM2" class="java.lang.String"/>
		<parameter name="P_KEY_PARAM3" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT RNUM
      ,MAX(SEQ) SEQ
      ,MAX(UPDT_IEM) UPDT_IEM
      ,MAX(BFCHG) BFCHG
      ,MAX(AFTCH) AFTCH
FROM (
      SELECT LEVEL RNUM
            ,'' SEQ
            ,'' UPDT_IEM
            ,'' BFCHG
            ,'' AFTCH
        FROM DUAL
      CONNECT BY LEVEL < 7
       UNION ALL
      SELECT ROWNUM RNUM
            ,TO_CHAR(MUWD.SEQ) SEQ
            ,MUWD.UPDT_IEM
            ,MUWD.BFCHG
            ,MUWD.AFTCH
        FROM MCRTF_UPDT_WTHDRW_DTL MUWD
       WHERE MUWD.COMPANY_CODE = $P{P_KEY_PARAM1}
         AND MUWD.DIVISION_CODE = $P{P_KEY_PARAM2}
   AND MUWD.MCRTF_PRESENTN_NO = $P{P_KEY_PARAM3})
 GROUP BY RNUM
 ORDER BY SEQ]]>
		</queryString>
		<field name="RNUM" class="java.math.BigDecimal"/>
		<field name="SEQ" class="java.lang.String"/>
		<field name="UPDT_IEM" class="java.lang.String"/>
		<field name="BFCHG" class="java.lang.String"/>
		<field name="AFTCH" class="java.lang.String"/>
	</subDataset>
	<parameter name="P_KEY_PARAM1" class="java.lang.String"/>
	<parameter name="P_KEY_PARAM2" class="java.lang.String"/>
	<parameter name="P_KEY_PARAM3" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT MUWM.COMPANY_CODE
      ,MUWM.DIVISION_CODE
      ,MUWM.MCRTF_PRESENTN_NO
      ,MUWM.MCRTF_REGIST_RCEPT_NO
      ,MUWM.PRESENTN_NO
      ,MUWM.REGIST_RCEPT_NO
      ,TO_CHAR(TO_DATE(MUWM.RCEPT_DATE,'YYYYMMDD'),'YYYY-MM-DD') RCEPT_DATE
      ,TO_CHAR(TO_DATE(MUWM.NTICE_DATE,'YYYYMMDD'),'YYYY-MM-DD') NTICE_DATE
      ,MUWM.UPDT_REASON
      ,MUWM.CSTMR_NM
      ,MUWM.RPRSNTV_NM
      ,MUWM.REQST_SE
      ,CC.ISSUE_TYPE
      ,TO_CHAR(TO_DATE(CC.CHIT_FRMTRM_DATE,'YYYYMMDD'),'YYYY-MM-DD') AS CHIT_FRMTRM_DATE
  FROM MCRTF_UPDT_WTHDRW_MST MUWM
 INNER JOIN CTRM_CMMN CC
    ON CC.COMPANY_CODE = MUWM.COMPANY_CODE
   AND CC.DIVISION_CODE = MUWM.DIVISION_CODE
   AND CC.PRESENTN_NO = MUWM.PRESENTN_NO
   --AND CC.REGIST_RCEPT_NO = MUWM.REGIST_RCEPT_NO
 WHERE MUWM.COMPANY_CODE = $P{P_KEY_PARAM1}
   AND MUWM.DIVISION_CODE = $P{P_KEY_PARAM2}
   AND MUWM.MCRTF_PRESENTN_NO = $P{P_KEY_PARAM3}]]>
	</queryString>
	<field name="COMPANY_CODE" class="java.lang.String"/>
	<field name="DIVISION_CODE" class="java.lang.String"/>
	<field name="MCRTF_PRESENTN_NO" class="java.lang.String"/>
	<field name="MCRTF_REGIST_RCEPT_NO" class="java.lang.String"/>
	<field name="PRESENTN_NO" class="java.lang.String"/>
	<field name="REGIST_RCEPT_NO" class="java.lang.String"/>
	<field name="RCEPT_DATE" class="java.lang.String"/>
	<field name="NTICE_DATE" class="java.lang.String"/>
	<field name="UPDT_REASON" class="java.lang.String"/>
	<field name="CSTMR_NM" class="java.lang.String"/>
	<field name="RPRSNTV_NM" class="java.lang.String"/>
	<field name="REQST_SE" class="java.lang.String"/>
	<field name="ISSUE_TYPE" class="java.lang.String"/>
	<field name="CHIT_FRMTRM_DATE" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
