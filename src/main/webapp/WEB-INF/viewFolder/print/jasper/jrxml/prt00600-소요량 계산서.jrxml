	<subDataset name="New Dataset 1" uuid="9961ada9-7efc-4262-a229-691808e364bf">
		<parameter name="P_COMPANY_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM1" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM2" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM3" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT  LPAD(ROWNUM, 3, '0') AS RAWMTRL_SEQ
       , R.ITEM_CODE
       , R.RAWMTRL_CODE
       , II.ITEM_NM
       , BOM.INPUT_QTY  || '(' || BOM.INPUT_BASS_UNIT || ')' AS USGQTY
       , R.USGQTY  AS TOTAL_USGQTY
    FROM DRWBAK_REQSTDOC_INCME_RAWMTRL R
   INNER JOIN DRWBAK_REQSTDOC_TRGET_THNG DRT
      ON R.PRESENTN_NO = DRT.PRESENTN_NO
     AND R.COMPANY_CODE = DRT.COMPANY_CODE
     AND R.THNG_SEQ = DRT.THNG_SEQ
   INNER JOIN IMPDEC_CERFIN_ITEM II
      ON R.Impdec_No = II.IMPDEC_MANAGE_NO
     AND R.COMPANY_CODE = II.COMPANY_CODE
     AND R.LNE_NO = II.LNE_NO
     AND R.POUCH_NO = II.POUCH_NO
    LEFT OUTER JOIN RESULT_BOM_AP BOM
      ON DRT.COMPANY_CODE = BOM.COMPANY_CODE
     AND DRT.DIVISION_CODE = BOM.DIVISION_CODE
     AND DRT.ITEM_CODE = BOM.PRODUCT_CODE
     AND DRT.USE_BOM_VERSION = BOM.BOM_VERSION
     AND R.RAWMTRL_CODE = BOM.ITEM_CODE
   WHERE R.PRESENTN_NO =  $P{P_KEY_PARAM1}
     AND R.ITEM_CODE =  $P{P_KEY_PARAM3}
     AND R.COMPANY_CODE = $P{P_COMPANY_CODE}
ORDER BY RAWMTRL_SEQ]]>
		</queryString>
		<field name="RAWMTRL_SEQ" class="java.lang.String"/>
		<field name="ITEM_CODE" class="java.lang.String"/>
		<field name="RAWMTRL_CODE" class="java.lang.String"/>
		<field name="ITEM_NM" class="java.lang.String"/>
		<field name="USGQTY" class="java.lang.String"/>
		<field name="TOTAL_USGQTY" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="P_COMPANY_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM1" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM2" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM3" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT ROWNUM AS NO
     , DR.PRESENTN_NO             -- 제출번호
     , DR.REGIST_RCEPT_NO         -- 관련신청건(접수번호)
     , DR.DRWBAK_REQ_DATE              --제출일자
     , NVL(DR.ECTMRK, (SELECT ECTMRK
                          FROM COMPANY
                         WHERE COMPANY_CODE = '1100'
                           AND ROWNUM = 1))  AS ECTMRK                     --통관고유번호
     , DR.CSTBRKR                    --관세사코드
     , DRT.ITEM_CODE
     , DRT.ITEM_NM
     , DRT.LNE_NO                    --란번호
     , DRT.ACCMLT_ORDER_QY            --누적오더수량(판매단위)
     , DRT.STTEMNT_PC_KRW             --금액
     , DR.REQREQY_CALC_MTH               --소요량 산정기준
     , I.SPEC               --제품규격
     , I.HS_CODE            --제품HS_CODE
     , COUNT(DRT.ITEM_CODE) OVER() AS LNE_TOTAL_COUNT
  FROM DRWBAK_REQSTDOC_CMMN   DR
 INNER JOIN DRWBAK_REQSTDOC_TRGET_THNG DRT
    ON DR.PRESENTN_NO = DRT.PRESENTN_NO
   AND DR.COMPANY_CODE = DRT.COMPANY_CODE
   AND DR.DIVISION_CODE = DRT.DIVISION_CODE
 LEFT OUTER JOIN ITEM_MST I
    ON DRT.COMPANY_CODE = I.COMPANY_CODE
   AND DRT.ITEM_CODE = I.ITEM_CODE
 WHERE DR.COMPANY_CODE = $P{P_COMPANY_CODE}
   AND DR.PRESENTN_NO = $P{P_KEY_PARAM1}]]>
	</queryString>
	<field name="NO" class="java.math.BigDecimal"/>
	<field name="PRESENTN_NO" class="java.lang.String"/>
	<field name="REGIST_RCEPT_NO" class="java.lang.String"/>
	<field name="DRWBAK_REQ_DATE" class="java.lang.String"/>
	<field name="ECTMRK" class="java.lang.String"/>
	<field name="CSTBRKR" class="java.lang.String"/>
	<field name="ITEM_CODE" class="java.lang.String"/>
	<field name="ITEM_NM" class="java.lang.String"/>
	<field name="LNE_NO" class="java.math.BigDecimal"/>
	<field name="ACCMLT_ORDER_QY" class="java.math.BigDecimal"/>
	<field name="STTEMNT_PC_KRW" class="java.math.BigDecimal"/>
	<field name="REQREQY_CALC_MTH" class="java.lang.String"/>
	<field name="SPEC" class="java.lang.String"/>
	<field name="HS_CODE" class="java.lang.String"/>
	<field name="LNE_TOTAL_COUNT" class="java.math.BigDecimal"/>
