	<subDataset name="New Dataset 1" uuid="9961ada9-7efc-4262-a229-691808e364bf">
		<parameter name="P_COMPANY_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="REGIST_RCEPT_NO" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="POUCH_NO" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM1" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM2" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM3" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT LPAD(ROWNUM,3, '0') AS "ROWNUM"
      , RAWMTRL_CODE
      , C.ITEM_NM AS RAWMTRL_NAME
      , C.RAWMTRL_SE
      , C.IMPDEC_NO
      , C.LNE_NO
      , C.POUCH_NO
      , TO_CHAR(TO_DATE(C.ACPT_DATE, 'YYYYMMDD'), 'YYYY-MM-DD') AS ACPT_DATE
      , TO_CHAR(TRUNC(CASE WHEN SM.IMP_BASS_UNIT = C.BASS_UNIT THEN C.USGQTY
                           ELSE (CASE WHEN SM.IMP_BASS_UNIT = 'KG' THEN C.USGQTY / 1000
                                     WHEN SM.IMP_BASS_UNIT = 'LB' THEN C.USGQTY / 0.453592 / 1000
                                     WHEN SM.IMP_BASS_UNIT = 'DR' THEN C.USGQTY / 1000 / 30
                                     WHEN SM.IMP_BASS_UNIT = 'GR' THEN C.USGQTY / 0.064799
                                     WHEN SM.IMP_BASS_UNIT = 'MT' THEN C.USGQTY / 1000 / 1000
                                     ELSE C.USGQTY
                                  END)
        END,3), 'FM999,999,999,990.000') AS USGQTY
      , SM.IMP_BASS_UNIT AS BASS_UNIT
      , '('||C.RAWMTRL_SE||') '||  C.IMPDEC_NO || '-' || LPAD(C.LNE_NO, 3, '0') || '-' || LPAD(C.POUCH_NO, 3, '0') AS CERIFY_NO
      , TO_CHAR(TRUNC(C.CSTMS,-1), 'FM999,999,999,999') AS CSTMS
      , ' ' AS DDC_RATE_PRDCTN
   FROM CTRM_CMMN A
  INNER JOIN CTRM_TRGET_THNG B
     ON A.COMPANY_CODE = B.COMPANY_CODE
    AND A.PRESENTN_NO = B.PRESENTN_NO
    AND A.DIVISION_CODE = B.DIVISION_CODE
  INNER JOIN CTRM_INCME_RAWMTRL C
     ON B.COMPANY_CODE = C.COMPANY_CODE
    AND B.DIVISION_CODE = C.DIVISION_CODE
    AND B.PRESENTN_NO = C.PRESENTN_NO
    AND B.SEQ = C.SEQ
  INNER JOIN INCME_LOCAL_BNT_SM SM
     ON SM.COMPANY_CODE = C.COMPANY_CODE
    AND SM.DIVISION_CODE = C.DIVISION_CODE
    AND SM.IMPDEC_NO = C.IMPDEC_NO
    AND SM.LNE_NO = C.LNE_NO
    AND SM.POUCH_NO = C.POUCH_NO
  WHERE A.COMPANY_CODE =  $P{P_KEY_PARAM1}
     AND A.DIVISION_CODE = $P{P_KEY_PARAM2}
     AND A.PRESENTN_NO = $P{P_KEY_PARAM3}
     AND B.SEQ = $P{POUCH_NO}
     AND TRUNC(C.CSTMS,-1) > 0]]>
		</queryString>
		<field name="ROWNUM" class="java.math.BigDecimal"/>
		<field name="RAWMTRL_CODE" class="java.lang.String"/>
		<field name="RAWMTRL_NAME" class="java.lang.String"/>
		<field name="RAWMTRL_SE" class="java.lang.String"/>
		<field name="IMPDEC_NO" class="java.lang.String"/>
		<field name="LNE_NO" class="java.math.BigDecimal"/>
		<field name="POUCH_NO" class="java.math.BigDecimal"/>
		<field name="ACPT_DATE" class="java.lang.String"/>
		<field name="USGQTY" class="java.math.BigDecimal"/>
		<field name="BASS_UNIT" class="java.lang.String"/>
		<field name="CERIFY_NO" class="java.lang.String"/>
		<field name="CSTMS" class="java.lang.String"/>
		<field name="DDC_RATE_PRDCTN" class="java.lang.String"/>
	</subDataset>
	<parameter name="P_COMPANY_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM1" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM2" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM3" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[/*******************************기납증 ************************************************/
SELECT ROWNUM AS NO
       , A.COMPANY_CODE
       , SUBSTR(A.SUBMIT_NO, 1, 5) ||'-'||SUBSTR(A.SUBMIT_NO, 6, 2)||'-'||SUBSTR(A.SUBMIT_NO, 8, 6) AS SUBMIT_NO
       , A.PRESENTN_NO
       , A.DIVISION_CODE
       , TO_CHAR(TO_DATE(SUBSTR(R54.REGIST_RCEP_DATE, 1,8), 'YYYYMMDD'), 'YYYY-MM-DD') AS REGIST_RCEP_DATE
       , A.CHIT_FRMTRM_DATE
       , A.REGIST_RCEPT_NO
       , B.SEQ
       , B.ITEM_CODE AS PRODUCT_CODE
       , B.ITEM_NM AS PRODUCT_NAME
       , TO_CHAR(B.ACCMLT_ORDER_QY, 'FM999,999,999,999')  || ' (' || B.BASS_UNIT || ')' AS ORDER_QTY
       , B.BASS_UNIT
       , A.REGIST_RCEPT_NO AS REF_NO
       , '001' AS REF_LNE_NO
       , B.SEQ AS REF_POUCH_NO
       , A.REGIST_RCEPT_NO || '-' || '001' || '-' ||  LPAD(B.SEQ,2,'0') AS CERTIFY_NO
      -- , CASE WHEN I.PRODUCT_CODE IS NULL THEN '0' ELSE '1' END AS CHECK_FLAG
       , COUNT(*) OVER() AS LNE_TOTAL_COUNT
       , A.CSTMR_NM_2 ||' (' ||  A.ECTMRK || ')'      AS    ECTMRK             --통관고유번호
    FROM CTRM_CMMN A
   INNER JOIN CTRM_TRGET_THNG B
      ON A.COMPANY_CODE = B.COMPANY_CODE
     AND A.DIVISION_CODE = B.DIVISION_CODE
     AND A.PRESENTN_NO = B.PRESENTN_NO
 INNER JOIN ( SELECT PRESENTN_NO
                     , COMPANY_CODE
                     , DIVISION_CODE
                     , SEQ
                     , SUM(DRWBAK_AMOUNT)
                FROM ( SELECT A.PRESENTN_NO
                              ,A.COMPANY_CODE
                              ,A.DIVISION_CODE
                              ,A.SEQ
                              ,TRUNC(AA.DRWBAK_AMOUNT,-1) DRWBAK_AMOUNT
                              , TRUNC(CASE WHEN B.IMP_BASS_UNIT = AA.BASS_UNIT THEN AA.USGQTY
                                           ELSE
                                             (CASE
                                                 WHEN B.IMP_BASS_UNIT = 'KG' THEN AA.USGQTY / 1000
                                                 WHEN B.IMP_BASS_UNIT = 'LB' THEN AA.USGQTY / 0.453592 / 1000
                                                 WHEN B.IMP_BASS_UNIT = 'DR' THEN AA.USGQTY / 1000 / 30
                                                 WHEN B.IMP_BASS_UNIT = 'GR' THEN AA.USGQTY / 0.064799
                                                 WHEN B.IMP_BASS_UNIT = 'MT' THEN AA.USGQTY / 1000 / 1000
                                               ELSE B.QY
                                               END)
                                       END, 3) AS USGQTY
                        FROM CTRM_TRGET_THNG A
                       INNER JOIN CTRM_INCME_RAWMTRL AA
                          ON A.COMPANY_CODE = AA.COMPANY_CODE
                         AND A.DIVISION_CODE = AA.DIVISION_CODE
                         AND A.PRESENTN_NO = AA.PRESENTN_NO
                         AND A.SEQ = AA.SEQ
                       INNER JOIN INCME_LOCAL_BNT_SM B
                          ON AA.COMPANY_CODE = B.COMPANY_CODE
                         AND AA.IMPDEC_NO = B.IMPDEC_NO
                         AND AA.LNE_NO = B.LNE_NO
                         AND AA.POUCH_NO = B.POUCH_NO
                         AND AA.RAWMTRL_CODE = B.ITEM_CODE
                       WHERE A.COMPANY_CODE =  $P{P_COMPANY_CODE}
                         AND A.DIVISION_CODE = $P{P_KEY_PARAM2}
                         AND A.PRESENTN_NO = $P{P_KEY_PARAM3}
                     )
               WHERE USGQTY > 0.000999999999999
                 AND REPLACE(DRWBAK_AMOUNT, ',','') > 0
               GROUP BY PRESENTN_NO, COMPANY_CODE, DIVISION_CODE, SEQ) C
    ON C.PRESENTN_NO = B.PRESENTN_NO
   AND C.COMPANY_CODE = B.COMPANY_CODE
   AND C.DIVISION_CODE = B.DIVISION_CODE
   AND C.SEQ = B.SEQ
    LEFT OUTER JOIN AN_UNIPASS_R54 R54
      ON A.COMPANY_CODE = R54.COMPANY_CODE
     AND A.DIVISION_CODE = R54.DIVISION_CODE
     AND A.REGIST_RCEPT_NO = R54.REGIST_RCEPT_NO
     AND R54.FORM_TYPE = '20' -- 기납증
   WHERE A.COMPANY_CODE = $P{P_KEY_PARAM1}
     AND A.DIVISION_CODE = $P{P_KEY_PARAM2}
     AND A.PRESENTN_NO = $P{P_KEY_PARAM3}]]>
	</queryString>
	<field name="NO" class="java.math.BigDecimal"/>
	<field name="COMPANY_CODE" class="java.lang.String"/>
	<field name="PRESENTN_NO" class="java.lang.String"/>
	<field name="DIVISION_CODE" class="java.lang.String"/>
	<field name="REGIST_RCEP_DATE" class="java.lang.String"/>
	<field name="REGIST_RCEPT_NO" class="java.lang.String"/>
	<field name="SEQ" class="java.math.BigDecimal"/>
	<field name="PRODUCT_CODE" class="java.lang.String"/>
	<field name="PRODUCT_NAME" class="java.lang.String"/>
	<field name="ORDER_QTY" class="java.lang.String"/>
	<field name="BASS_UNIT" class="java.lang.String"/>
	<field name="REF_NO" class="java.lang.String"/>
	<field name="REF_LNE_NO" class="java.lang.String"/>
	<field name="REF_POUCH_NO" class="java.math.BigDecimal"/>
	<field name="CERTIFY_NO" class="java.lang.String"/>
	<field name="LNE_TOTAL_COUNT" class="java.math.BigDecimal"/>
	<field name="ECTMRK" class="java.lang.String"/>
	<field name="SUBMIT_NO" class="java.lang.String"/>
