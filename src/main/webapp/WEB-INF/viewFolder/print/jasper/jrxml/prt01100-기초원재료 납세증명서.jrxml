	<subDataset name="dataSet4" uuid="920e44a5-462f-4330-a74c-01b934354241">
		<field name="field1" class="java.lang.String"/>
		<field name="field2" class="java.lang.String"/>
		<field name="field3" class="java.lang.String"/>
		<field name="field4" class="java.lang.String"/>
		<field name="field5" class="java.lang.String"/>
		<field name="field6" class="java.lang.String"/>
		<field name="field7" class="java.lang.String"/>
		<field name="field8" class="java.lang.String"/>
		<field name="field9" class="java.lang.String"/>
		<field name="field10" class="java.lang.String"/>
		<field name="field11" class="java.lang.String"/>
		<field name="field12" class="java.lang.String"/>
		<field name="field13" class="java.lang.String"/>
	</subDataset>
	<parameter name="P_KEY_PARAM1" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM2" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM3" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT A.SUBMIT_NO  AS PRESENTN_NO
        , A.REGIST_RCEPT_NO
        , TO_CHAR(TO_DATE(A.CHIT_FRMTRM_DATE, 'YYYYMMDD'), 'YYYY-MM-DD') AS CHIT_FRMTRM_DATE
        , ' ' AS CSTBRKR
        , ' ' AS CSTBRKR_CODE
        , A.DRWBAK_SE_CODE
        , A.DRWBAK_SE
        , A.REQREQY_CALC_MTH
        , A.REQREQY_CALC_NM
        , A.BIZRNO
        , A.ECTMRK
        , A.TELNO_1
        , A.CSTMR_NM_1
        , A.RPRSNTV_NM_1
        , A.CSTMR_BIZRNO
        , A.CSTMR_ADRES_1
        , A.CSTMR_ECTMRK
        , MAX(CTT.ITEM_CODE) OVER() AS ITEM_CODE
        , TO_CHAR(TO_DATE(A.DATE_EX, 'YYYYMMDD'), 'YYYY-MM-DD') AS DATE_EX
        , TRIM(TO_CHAR(TRUNC(ISSUE.ACCMLT_ORDER_QY,0),'999,999,990')) AS ACCMLT_ORDER_QY
        , MAX(CTT.BASS_UNIT)  OVER() AS BASS_UNIT
        , TRIM(TO_CHAR(TRUNC(ISSUE.STTEMNT_PC_KRW,0),'999,999,990')) AS STTEMNT_PC_KRW
        , TRIM(TO_CHAR(TRUNC(TAX.TAX_SUM,0),'999,999,990')) AS CSTMS
        , 0 AS INTTAX
        , 0 AS TRANTAX
        , 0 AS LQTX_AMOUNT
        , 0 AS ECX_AMOUNT
        , 0 AS AGSPT
        , TRIM(TO_CHAR(TRUNC(TAX.TAX_SUM,0),'999,999,990')) AS SUM_AMOUNT
        , NVL(A.CSMHSE_CODE, ' ') AS CSMHSE_CODE
        , NVL(A.CSMHSE_TEXT, CC.CODE_NM) AS CSMHSE_TEXT
        , A.SUBMIT_NO
        , B.COMPANY_NM AS FROM_COMPANY_NAME
        , B.RPRSNTV_NM AS FROM_COMPANY_PRSN
        , B.ADRES AS ADDRESS
        , FC01_GET_HSCODE_FORMAT(A.HS_CODE) AS HS_CODE
        , TO_CHAR(TO_DATE(SUBSTR(R54.REGIST_RCEP_DATE, 1, 8), 'YYYYMMDD'), 'YYYY-MM-DD') AS REGIST_RCEP_DATE
    FROM CTRM_CMMN A
    LEFT OUTER JOIN AN_UNIPASS_R54 R54
      ON A.COMPANY_CODE = R54.COMPANY_CODE
     AND A.DIVISION_CODE = R54.DIVISION_CODE
     AND A.REGIST_RCEPT_NO = R54.REGIST_RCEPT_NO
    LEFT OUTER JOIN COM_CD CC
      ON CC.CATEGORY_CD = 'CT'
     AND CC.CODE_CD = A.CSMHSE_CODE
   INNER JOIN CTRM_TRGET_THNG CTT
      ON A.COMPANY_CODE = CTT.COMPANY_CODE
     AND A.DIVISION_CODE = CTT.DIVISION_CODE
     AND A.PRESENTN_NO = CTT.PRESENTN_NO
   INNER JOIN ( SELECT PRESENTN_NO
                       ,COMPANY_CODE
                       ,DIVISION_CODE
                       ,SUM(ACCMLT_ORDER_QY) AS ACCMLT_ORDER_QY
                       ,SUM(STTEMNT_PC_KRW) AS STTEMNT_PC_KRW
                  FROM (SELECT DISTINCT
                               PRESENTN_NO
                               , COMPANY_CODE
                               , DIVISION_CODE
                               , ACCMLT_ORDER_QY
                               , STTEMNT_PC_KRW

                          FROM (SELECT  A.PRESENTN_NO
                                        , A.COMPANY_CODE
                                        , A.DIVISION_CODE
                                        , A.ACCMLT_ORDER_QY
                                        , A.STTEMNT_PC_KRW
                                        , CASE WHEN B.IMP_BASS_UNIT = AA.BASS_UNIT THEN AA.USGQTY
                                                     ELSE
                                                       (CASE
                                                           WHEN B.IMP_BASS_UNIT = 'KG' THEN AA.USGQTY / 1000
                                                           WHEN B.IMP_BASS_UNIT = 'LB' THEN AA.USGQTY / 0.453592 / 1000
                                                           WHEN B.IMP_BASS_UNIT = 'DR' THEN AA.USGQTY / 1000 / 30
                                                           WHEN B.IMP_BASS_UNIT = 'GR' THEN AA.USGQTY / 0.064799
                                                           WHEN B.IMP_BASS_UNIT = 'MT' THEN AA.USGQTY / 1000 / 1000
                                                         ELSE B.QY
                                                         END)
                                                 END AS USGQTY
                                  FROM CTRM_TRGET_THNG A
                                 INNER JOIN CTRM_INCME_RAWMTRL AA
                                    ON A.COMPANY_CODE = AA.COMPANY_CODE
                                   AND A.DIVISION_CODE = AA.DIVISION_CODE
                                   AND A.PRESENTN_NO = AA.PRESENTN_NO
                                   AND A.SEQ = AA.SEQ
                                 INNER JOIN INCME_LOCAL_BNT_SM B
                                    ON AA.COMPANY_CODE = B.COMPANY_CODE
                                   AND AA.IMPDEC_NO = B.IMPDEC_NO
                                   AND AA.LNE_NO = B.LNE_NO
                                   AND AA.POUCH_NO = B.POUCH_NO
                                   AND AA.RAWMTRL_CODE = B.ITEM_CODE
                                 WHERE A.COMPANY_CODE =  $P{P_KEY_PARAM1}
                                   AND A.DIVISION_CODE =  $P{P_KEY_PARAM2}
                                   AND A.PRESENTN_NO = $P{P_KEY_PARAM3}
                                   AND AA.CSTMS > 9.9999999999999
                               )
                               WHERE TRUNC(USGQTY, 3) > 0.000999999999999
                       )
                 GROUP BY PRESENTN_NO, COMPANY_CODE, DIVISION_CODE) ISSUE
    ON A.COMPANY_CODE = ISSUE.COMPANY_CODE
   AND A.DIVISION_CODE = ISSUE.DIVISION_CODE
   AND A.PRESENTN_NO = ISSUE.PRESENTN_NO
 INNER JOIN (SELECT A.PRESENTN_NO
                   , A.COMPANY_CODE
                   , A.DIVISION_CODE
                   ,TRUNC(SUM(TAX_SUM), -1) AS TAX_SUM
              FROM ( SELECT A.PRESENTN_NO
                            , A.COMPANY_CODE
                            , A.DIVISION_CODE
                            , TRUNC(CASE WHEN B.IMP_BASS_UNIT = A.BASS_UNIT THEN A.USGQTY
                                         ELSE
                                           (CASE
                                               WHEN B.IMP_BASS_UNIT = 'KG' THEN A.USGQTY / 1000
                                               WHEN B.IMP_BASS_UNIT = 'LB' THEN A.USGQTY / 0.453592 / 1000
                                               WHEN B.IMP_BASS_UNIT = 'DR' THEN A.USGQTY / 1000 / 30
                                               WHEN B.IMP_BASS_UNIT = 'GR' THEN A.USGQTY / 0.064799
                                               WHEN B.IMP_BASS_UNIT = 'MT' THEN A.USGQTY / 1000 / 1000
                                             ELSE B.QY
                                             END)
                                     END, 3) AS USGQTY
                            , (TRUNC(A.CSTMS, -1) + TRUNC(A.INTTAX, -1) + TRUNC(A.TRANTAX, -1) + TRUNC(A.LQTX_AMOUNT, -1) + TRUNC(A.ECX_AMOUNT, -1) + TRUNC(A.AGSPT, -1)) AS TAX_SUM
                       FROM CTRM_INCME_RAWMTRL A
                      INNER JOIN INCME_LOCAL_BNT_SM B
                         ON A.COMPANY_CODE = B.COMPANY_CODE
                        AND A.IMPDEC_NO = B.IMPDEC_NO
                        AND A.LNE_NO = B.LNE_NO
                        AND A.POUCH_NO = B.POUCH_NO
                        AND A.RAWMTRL_CODE = B.ITEM_CODE
                      WHERE A.COMPANY_CODE =  $P{P_KEY_PARAM1}
                        AND A.DIVISION_CODE =  $P{P_KEY_PARAM2}
                        AND A.PRESENTN_NO = $P{P_KEY_PARAM3}
                   ) A
             WHERE TRUNC(USGQTY, 3) > 0.000999999999999
             GROUP BY A.PRESENTN_NO, A.COMPANY_CODE, A.DIVISION_CODE) TAX
    ON A.COMPANY_CODE = TAX.COMPANY_CODE
   AND A.DIVISION_CODE = TAX.DIVISION_CODE
   AND A.PRESENTN_NO = TAX.PRESENTN_NO
 INNER JOIN COMPANY B
    ON A.COMPANY_CODE = B.COMPANY_CODE
 WHERE A.ISSUE_TYPE = '02'
   AND A.COMPANY_CODE =   $P{P_KEY_PARAM1}
   AND A.DIVISION_CODE =  $P{P_KEY_PARAM2}
   AND A.PRESENTN_NO = $P{P_KEY_PARAM3}]]>
	</queryString>
