	<subDataset name="dataSet1" whenResourceMissingType="Empty" uuid="9961ada9-7efc-4262-a229-691808e364bf">
		<parameter name="P_KEY_PARAM1" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM2" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM3" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT LPAD(ROWNUM, 3, '0') AS LINE_NUMBER
       , ITEM_CODE
       , ITEM_NM
       , ACCMLT_ORDER_QY
       , BASS_UNIT
       , STTEMNT_PC_KRW
       , KRW_CRNCY
       , CSTMS
       , INTTAX
       , TRANTAX
       , LQTX_AMOUNT
       , ECX_AMOUNT
       , AGSPT
       , DRWBAK_AMOUNT
       , BASIS_DOC_NO
       , SUPT_DOC_SE
  FROM (SELECT
               ITEM_CODE
               , ITEM_NM
               , ACCMLT_ORDER_QY
               , BASS_UNIT
               , STTEMNT_PC_KRW
               , KRW_CRNCY
               , TRIM(TO_CHAR(SUM(CSTMS),'999,999,990')) AS CSTMS
               , TRIM(TO_CHAR(SUM(INTTAX),'999,999,990')) AS INTTAX
               , TRIM(TO_CHAR(SUM(TRANTAX),'999,999,990')) AS TRANTAX
               , TRIM(TO_CHAR(SUM(LQTX_AMOUNT),'999,999,990')) AS LQTX_AMOUNT
               , TRIM(TO_CHAR(SUM(ECX_AMOUNT),'999,999,990')) AS ECX_AMOUNT
               , TRIM(TO_CHAR(SUM(AGSPT),'999,999,990')) AS AGSPT
               , TRIM(TO_CHAR(SUM(DRWBAK_AMOUNT),'999,999,990')) AS DRWBAK_AMOUNT
               , BASIS_DOC_NO
               , SUPT_DOC_SE

          FROM (SELECT  A.SEQ
                        ,A.ITEM_CODE
                        ,A.ITEM_NM
                        ,TRIM(TO_CHAR(A.ACCMLT_ORDER_QY,'999,999,990')) ACCMLT_ORDER_QY
                        ,A.BASS_UNIT
                        ,TRIM(TO_CHAR(A.STTEMNT_PC_KRW,'999,999,990')) STTEMNT_PC_KRW
                        ,A.KRW_CRNCY
                        ,TRUNC(AA.CSTMS,-1) CSTMS
                        ,TRUNC(AA.INTTAX,-1) INTTAX
                        ,TRUNC(AA.TRANTAX,-1) TRANTAX
                        ,TRUNC(AA.LQTX_AMOUNT,-1) LQTX_AMOUNT
                        ,TRUNC(AA.ECX_AMOUNT,-1) ECX_AMOUNT
                        ,TRUNC(AA.AGSPT,-1) AGSPT
                        ,TRUNC(AA.DRWBAK_AMOUNT,-1) DRWBAK_AMOUNT
                        , '['||LPAD(A.SUPT_DOC_SE, 2,'0')||']매매계약서 등' AS BASIS_DOC_NO
                        ,A.SUPT_DOC_SE
                        , TRUNC(CASE WHEN B.IMP_BASS_UNIT = AA.BASS_UNIT THEN AA.USGQTY
                                     ELSE
                                       (CASE
                                           WHEN B.IMP_BASS_UNIT = 'KG' THEN AA.USGQTY / 1000
                                           WHEN B.IMP_BASS_UNIT = 'LB' THEN AA.USGQTY / 0.453592 / 1000
                                           WHEN B.IMP_BASS_UNIT = 'DR' THEN AA.USGQTY / 1000 / 30
                                           WHEN B.IMP_BASS_UNIT = 'GR' THEN AA.USGQTY / 0.064799
                                           WHEN B.IMP_BASS_UNIT = 'MT' THEN AA.USGQTY / 1000 / 1000
                                         ELSE B.QY
                                         END)
                                 END, 3) AS USGQTY
                  FROM CTRM_TRGET_THNG A
                 INNER JOIN CTRM_INCME_RAWMTRL AA
                    ON A.COMPANY_CODE = AA.COMPANY_CODE
                   AND A.DIVISION_CODE = AA.DIVISION_CODE
                   AND A.PRESENTN_NO = AA.PRESENTN_NO
                   AND A.SEQ = AA.SEQ
                 INNER JOIN INCME_LOCAL_BNT_SM B
                    ON AA.COMPANY_CODE = B.COMPANY_CODE
                   AND AA.IMPDEC_NO = B.IMPDEC_NO
                   AND AA.LNE_NO = B.LNE_NO
                   AND AA.POUCH_NO = B.POUCH_NO
                   AND AA.RAWMTRL_CODE = B.ITEM_CODE
                 WHERE A.COMPANY_CODE =  $P{P_KEY_PARAM1}
                   AND A.DIVISION_CODE =  $P{P_KEY_PARAM2}
                   AND A.PRESENTN_NO = $P{P_KEY_PARAM3}
               )
         WHERE USGQTY > 0.000999999999999
        GROUP BY SEQ, ITEM_CODE, ITEM_NM, ACCMLT_ORDER_QY, BASS_UNIT, STTEMNT_PC_KRW, KRW_CRNCY, BASIS_DOC_NO, SUPT_DOC_SE
        ORDER BY SEQ ASC
       )
 WHERE REPLACE(CSTMS, ',','') > 0]]>
		</queryString>
		<field name="LINE_NUMBER" class="java.math.BigDecimal"/>
		<field name="ITEM_CODE" class="java.lang.String"/>
		<field name="ITEM_NM" class="java.lang.String"/>
		<field name="ACCMLT_ORDER_QY" class="java.lang.String"/>
		<field name="BASS_UNIT" class="java.lang.String"/>
		<field name="STTEMNT_PC_KRW" class="java.lang.String"/>
		<field name="KRW_CRNCY" class="java.lang.String"/>
		<field name="CSTMS" class="java.lang.String"/>
		<field name="INTTAX" class="java.lang.String"/>
		<field name="TRANTAX" class="java.lang.String"/>
		<field name="LQTX_AMOUNT" class="java.lang.String"/>
		<field name="ECX_AMOUNT" class="java.lang.String"/>
		<field name="AGSPT" class="java.lang.String"/>
		<field name="DRWBAK_AMOUNT" class="java.lang.String"/>
		<field name="BASIS_DOC_NO" class="java.lang.String"/>
		<field name="SUPT_DOC_SE" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataSet2" uuid="5ce52b62-054d-4444-abf7-4fdb1c99d3c0">
		<parameter name="P_KEY_PARAM1" class="java.lang.String"/>
		<parameter name="P_KEY_PARAM2" class="java.lang.String"/>
		<parameter name="P_KEY_PARAM3" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT LPAD(ROWNUM, 4, '0') AS LINE_NUMBER
           , COMPANY_CODE
          ,DIVISION_CODE
          ,PRESENTN_NO
          ,SEQ
          ,RAWMTRL_SEQ
          ,ITEM_CODE
          ,RAWMTRL_CODE
          ,ITEM_NM
          ,FC01_GET_HSCODE_FORMAT(HS_CODE) AS HS_CODE
          ,RAWMTRL_SE
          ,IMPDEC_NO
          ,LNE_NO
          ,POUCH_NO
          ,ACPT_DATE
          ,USGQTY
          ,BASS_UNIT
          ,DDC_RATE_PRDCTN
          ,ACPLC_CRNCY
          ,TRGET_AT
          ,BY_PRODUCT_SE
          ,CSTMS
          ,INTTAX
          ,TRANTAX
          ,LQTX_AMOUNT
          ,ECX_AMOUNT
          ,AGSPT
          ,DRWBAK_AMOUNT
          ,PO_AMOUNT
      FROM (SELECT DISTINCT
                   COMPANY_CODE
                    ,DIVISION_CODE
                    ,PRESENTN_NO
                    ,SEQ
                    ,RAWMTRL_SEQ
                    ,ITEM_CODE
                    ,RAWMTRL_CODE
                    ,ITEM_NM
                    ,HS_CODE
                    ,RAWMTRL_SE
                    ,IMPDEC_NO
                    ,LNE_NO
                    ,POUCH_NO
                    ,ACPT_DATE
                    ,USGQTY
                    ,BASS_UNIT
                    ,DDC_RATE_PRDCTN
                    ,ACPLC_CRNCY
                    ,TRGET_AT
                    ,BY_PRODUCT_SE
                    ,CSTMS
                    ,INTTAX
                    ,TRANTAX
                    ,LQTX_AMOUNT
                    ,ECX_AMOUNT
                    ,AGSPT
                    ,DRWBAK_AMOUNT
                    ,PO_AMOUNT
              FROM (SELECT

                            AA.COMPANY_CODE
                            ,AA.DIVISION_CODE
                            ,AA.PRESENTN_NO
                            ,AA.SEQ
                            ,AA.RAWMTRL_SEQ
                            ,AA.ITEM_CODE
                            ,AA.RAWMTRL_CODE
                            ,AA.ITEM_NM
                            ,AA.HS_CODE
                            ,AA.RAWMTRL_SE
                            ,AA.IMPDEC_NO
                            ,AA.LNE_NO
                            ,AA.POUCH_NO
                            ,TO_CHAR(TO_DATE(AA.ACPT_DATE,'YYYYMMDD'), 'YYYY-MM-DD') ACPT_DATE
                            ,B.IMP_BASS_UNIT AS BASS_UNIT
                            ,AA.DDC_RATE_PRDCTN
                            ,AA.ACPLC_CRNCY
                            ,AA.TRGET_AT
                            ,AA.BY_PRODUCT_SE
                            ,TRIM(TO_CHAR(TRUNC(AA.CSTMS,-1),'999,999,990')) CSTMS
                            ,TRIM(TO_CHAR(TRUNC(AA.INTTAX,-1),'999,999,990')) INTTAX
                            ,TRIM(TO_CHAR(TRUNC(AA.TRANTAX,-1),'999,999,990')) TRANTAX
                            ,TRIM(TO_CHAR(TRUNC(AA.LQTX_AMOUNT,-1),'999,999,990')) LQTX_AMOUNT
                            ,TRIM(TO_CHAR(TRUNC(AA.ECX_AMOUNT,-1),'999,999,990')) ECX_AMOUNT
                            ,TRIM(TO_CHAR(TRUNC(AA.AGSPT,-1),'999,999,990')) AGSPT
                            ,TRIM(TO_CHAR(TRUNC(AA.DRWBAK_AMOUNT,-1),'999,999,990')) DRWBAK_AMOUNT
                           -- ,TRIM(TO_CHAR(TRUNC(CCD.PO_AMOUNT/CCD.QY,-1),'999,999,990')) PO_AMOUNT
                            ,'' AS PO_AMOUNT
                            , TRUNC(CASE WHEN B.IMP_BASS_UNIT = AA.BASS_UNIT THEN AA.USGQTY
                                         ELSE
                                           (CASE
                                               WHEN B.IMP_BASS_UNIT = 'KG' THEN AA.USGQTY / 1000
                                               WHEN B.IMP_BASS_UNIT = 'LB' THEN AA.USGQTY / 0.453592 / 1000
                                               WHEN B.IMP_BASS_UNIT = 'DR' THEN AA.USGQTY / 1000 / 30
                                               WHEN B.IMP_BASS_UNIT = 'GR' THEN AA.USGQTY / 0.064799
                                               WHEN B.IMP_BASS_UNIT = 'MT' THEN AA.USGQTY / 1000 / 1000
                                             ELSE B.QY
                                             END)
                                     END, 3) AS USGQTY
                      FROM CTRM_TRGET_THNG A
                     INNER JOIN CTRM_INCME_RAWMTRL AA
                        ON A.COMPANY_CODE = AA.COMPANY_CODE
                       AND A.DIVISION_CODE = AA.DIVISION_CODE
                       AND A.PRESENTN_NO = AA.PRESENTN_NO
                       AND A.SEQ = AA.SEQ
                     INNER JOIN INCME_LOCAL_BNT_SM B
                        ON AA.COMPANY_CODE = B.COMPANY_CODE
                       AND AA.IMPDEC_NO = B.IMPDEC_NO
                       AND AA.LNE_NO = B.LNE_NO
                       AND AA.POUCH_NO = B.POUCH_NO
                       AND AA.RAWMTRL_CODE = B.ITEM_CODE
                     WHERE A.COMPANY_CODE =  $P{P_KEY_PARAM1}
                       AND A.DIVISION_CODE =  $P{P_KEY_PARAM2}
                       AND A.PRESENTN_NO = $P{P_KEY_PARAM3}
                       AND TRUNC(AA.USGQTY, 3) > 0.000999999999999
                   )
             WHERE USGQTY > 0
             ORDER BY SEQ ,RAWMTRL_SEQ ASC
           )
WHERE REPLACE(CSTMS, ',', '') > 0]]>
		</queryString>
		<field name="COMPANY_CODE" class="java.lang.String"/>
		<field name="DIVISION_CODE" class="java.lang.String"/>
		<field name="PRESENTN_NO" class="java.lang.String"/>
		<field name="SEQ" class="java.math.BigDecimal"/>
		<field name="LINE_NUMBER" class="java.math.BigDecimal"/>
		<field name="ITEM_CODE" class="java.lang.String"/>
		<field name="RAWMTRL_CODE" class="java.lang.String"/>
		<field name="ITEM_NM" class="java.lang.String"/>
		<field name="HS_CODE" class="java.lang.String"/>
		<field name="RAWMTRL_SE" class="java.lang.String"/>
		<field name="IMPDEC_NO" class="java.lang.String"/>
		<field name="LNE_NO" class="java.math.BigDecimal"/>
		<field name="POUCH_NO" class="java.math.BigDecimal"/>
		<field name="ACPT_DATE" class="java.lang.String"/>
		<field name="USGQTY" class="java.math.BigDecimal"/>
		<field name="BASS_UNIT" class="java.lang.String"/>
		<field name="DDC_RATE_PRDCTN" class="java.math.BigDecimal"/>
		<field name="ACPLC_CRNCY" class="java.lang.String"/>
		<field name="TRGET_AT" class="java.lang.String"/>
		<field name="BY_PRODUCT_SE" class="java.lang.String"/>
		<field name="CSTMS" class="java.lang.String"/>
		<field name="INTTAX" class="java.lang.String"/>
		<field name="TRANTAX" class="java.lang.String"/>
		<field name="LQTX_AMOUNT" class="java.lang.String"/>
		<field name="ECX_AMOUNT" class="java.lang.String"/>
		<field name="AGSPT" class="java.lang.String"/>
		<field name="DRWBAK_AMOUNT" class="java.lang.String"/>
		<field name="PO_AMOUNT" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataSet3" uuid="6325ee96-b41e-401b-a4b8-82e6f3a8da34">
		<field name="field1" class="java.lang.String"/>
