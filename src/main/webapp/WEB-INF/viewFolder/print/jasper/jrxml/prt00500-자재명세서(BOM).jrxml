	<subDataset name="New Dataset 1" uuid="9961ada9-7efc-4262-a229-691808e364bf">
		<parameter name="P_COMPANY_CODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM1" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM2" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM3" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_PRODUCT_CODE" class="java.lang.String"/>
		<parameter name="P_USE_BOM_VERSION" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT LPAD(ROWNUM,3, '0') AS BOM_SEQ
       , H.ITEM_CODE          --부품식별번호
       , H.ITEM_NAME          --부품명
       , H.ITEM_CODE   AS PARENT_ITEM_CODE       --상위부품번호
       , H.INPUT_QTY          --소요량
       , H.INPUT_BASS_UNIT    --소요량단위
  FROM DRWBAK_REQSTDOC_CMMN   DR
 INNER JOIN DRWBAK_REQSTDOC_TRGET_THNG DRT
    ON DR.PRESENTN_NO = DRT.PRESENTN_NO
   AND DR.COMPANY_CODE = DRT.COMPANY_CODE
   AND DR.DIVISION_CODE = DRT.DIVISION_CODE
 INNER JOIN DRWBAK_REQSTDOC_INCME_RAWMTRL DRIR
    ON DRIR.PRESENTN_NO = DRT.PRESENTN_NO
   AND DRIR.COMPANY_CODE = DRT.COMPANY_CODE
   AND DRIR.THNG_SEQ = DRT.THNG_SEQ
 INNER JOIN RESULT_BOM_AP H
    ON DRT.COMPANY_CODE = H.COMPANY_CODE
   AND DRT.DIVISION_CODE = H.DIVISION_CODE
   AND DRT.ITEM_CODE = H.PRODUCT_CODE
   AND DRIR.RAWMTRL_CODE = H.ITEM_CODE
 WHERE DR.COMPANY_CODE =  $P{P_COMPANY_CODE}
   AND DR.PRESENTN_NO = $P{P_KEY_PARAM1}
   AND H.BOM_VERSION = $P{P_USE_BOM_VERSION}
   AND H.PRODUCT_CODE = $P{P_PRODUCT_CODE}
]]>
		</queryString>
		<field name="BOM_SEQ" class="java.lang.String"/>
		<field name="ITEM_CODE" class="java.lang.String"/>
		<field name="ITEM_NAME" class="java.lang.String"/>
		<field name="PARENT_ITEM_CODE" class="java.lang.String"/>
		<field name="INPUT_QTY" class="java.math.BigDecimal"/>
		<field name="INPUT_BASS_UNIT" class="java.lang.String"/>
	</subDataset>
	<parameter name="P_COMPANY_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM1" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM2" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_KEY_PARAM3" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DR.PRESENTN_NO             -- 제출번호
      , DR.SUBMIT_NO
      , DR.REGIST_RCEPT_NO         -- 관련신청건(접수번호)
      , TO_CHAR(TO_DATE(DR.DRWBAK_REQ_DATE,'YYYYMMDDHH24MISS'), 'YYYY-MM-DD') AS DRWBAK_REQ_DATE         --제출일자
      , NVL(DR.ECTMRK, (SELECT ECTMRK
                          FROM COMPANY
                         WHERE COMPANY_CODE = '1100'
                           AND ROWNUM = 1))           AS    ECTMRK             --통관고유번호
      , DR.CSTBRKR                 --관세사코드
      , DRT.ITEM_CODE
      , DRT.ITEM_NM
      , I.SPEC
      , CASE WHEN DR.HS_CODE IS NULL THEN I.HS_CODE ELSE DR.HS_CODE END AS HS_CODE
      , (SELECT DISTINCT TO_CHAR(TO_DATE(BOM_VERSION,'YYYYMMDD'), 'YYYYMMDD')
           FROM RESULT_BOM_AP H
          WHERE H.COMPANY_CODE = DRT.COMPANY_CODE
            AND H.DIVISION_CODE = DRT.DIVISION_CODE
            AND H.PRODUCT_CODE = DRT.ITEM_CODE
            AND H.BOM_VERSION = (SELECT MAX(H.BOM_VERSION)
                                  FROM RESULT_BOM_AP H
                                 WHERE H.COMPANY_CODE = DRT.COMPANY_CODE
                                   AND H.DIVISION_CODE = DRT.DIVISION_CODE
                                   AND H.PRODUCT_CODE = DRT.ITEM_CODE
                                   AND H.BOM_VERSION < DRT.DSPTH_DATE)) AS USE_BOM_VERSION
      , (SELECT DISTINCT TO_CHAR(TO_DATE(BOM_VERSION,'YYYYMMDD'), 'YYYY-MM-DD')
           FROM RESULT_BOM_AP H
          WHERE H.COMPANY_CODE = DRT.COMPANY_CODE
            AND H.DIVISION_CODE = DRT.DIVISION_CODE
            AND H.PRODUCT_CODE = DRT.ITEM_CODE
            AND H.BOM_VERSION = (SELECT MAX(H.BOM_VERSION)
                                  FROM RESULT_BOM_AP H
                                 WHERE H.COMPANY_CODE = DRT.COMPANY_CODE
                                   AND H.DIVISION_CODE = DRT.DIVISION_CODE
                                   AND H.PRODUCT_CODE = DRT.ITEM_CODE
                                   AND H.BOM_VERSION < DRT.DSPTH_DATE))
        || ' ~ 9999-12-31' AS YYYYMMDD_RANGE
  FROM DRWBAK_REQSTDOC_CMMN   DR
 INNER JOIN DRWBAK_REQSTDOC_TRGET_THNG DRT
    ON DR.PRESENTN_NO = DRT.PRESENTN_NO
   AND DR.COMPANY_CODE = DRT.COMPANY_CODE
   AND DR.DIVISION_CODE = DRT.DIVISION_CODE
  LEFT OUTER JOIN ITEM_MST I
    ON DRT.COMPANY_CODE = I.COMPANY_CODE
   AND DRT.ITEM_CODE = I.ITEM_CODE
 WHERE DR.COMPANY_CODE =  $P{P_COMPANY_CODE}
   AND DR.PRESENTN_NO = $P{P_KEY_PARAM1}]]>
	</queryString>
	<field name="PRESENTN_NO" class="java.lang.String"/>
	<field name="REGIST_RCEPT_NO" class="java.lang.String"/>
	<field name="DRWBAK_REQ_DATE" class="java.lang.String"/>
	<field name="ECTMRK" class="java.lang.String"/>
	<field name="CSTBRKR" class="java.lang.String"/>
	<field name="ITEM_CODE" class="java.lang.String"/>
	<field name="ITEM_NM" class="java.lang.String"/>
	<field name="SPEC" class="java.lang.String"/>
	<field name="HS_CODE" class="java.lang.String"/>
	<field name="USE_BOM_VERSION" class="java.lang.String"/>
	<field name="YYYYMMDD_RANGE" class="java.lang.String"/>
	<field name="SUBMIT_NO" class="java.lang.String"/>
