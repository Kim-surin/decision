	<subDataset name="New Dataset 1" uuid="9961ada9-7efc-4262-a229-691808e364bf">
		<parameter name="P_KEY_PARAM1" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM2" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_KEY_PARAM3" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT CTR.SEQ
      ,CTR.RAWMTRL_CODE
      ,CTR.ITEM_NM
      ,CTR.GOODS_BRAND
      ,CTR.ORGIN_NATION_CODE
      ,CTR.RAWMTRL_SE
      ,CTR.IMPDEC_NO
      ,CTR.LNE_NO
      ,CTR.POUCH_NO
      ,CTR.ACPT_DATE
      ,CTR.DATE_EX
      ,CTR.USGQTY
      ,CTR.BASS_UNIT
      ,CCD.PO_AMOUNT
      ,TRIM(TO_CHAR(TRUNC(CTR.CSTMS,0),'999,999,990')) CSTMS
      ,TRIM(TO_CHAR(TRUNC(CTR.INTTAX,0),'999,999,990')) INTTAX
      ,TRIM(TO_CHAR(TRUNC(CTR.TRANTAX,0),'999,999,990')) TRANTAX
      ,TRIM(TO_CHAR(TRUNC(CTR.LQTX_AMOUNT,0),'999,999,990')) LQTX_AMOUNT
      ,TRIM(TO_CHAR(TRUNC(CTR.ECX_AMOUNT,0),'999,999,990')) ECX_AMOUNT
      ,TRIM(TO_CHAR(TRUNC(CTR.AGSPT,0),'999,999,990')) AGSPT
      ,TRIM(TO_CHAR(TRUNC(CTR.DRWBAK_AMOUNT,0),'999,999,990')) DRWBAK_AMOUNT
      ,CTR.BASIS_DOC_NO
  FROM CTRM_THING_RAWMTRL CTR
 INNER JOIN CCPY_CSTMR_DMSTC CCD
    ON CCD.COMPANY_CODE = CTR.COMPANY_CODE
   AND CCD.DIVISION_CODE = CTR.DIVISION_CODE
   AND CCD.BASIS_DTA_MANAGE_NO = CTR.IMPDEC_NO
   AND CCD.LNE_NO = CTR.LNE_NO
   AND CCD.POUCH_NO = CTR.POUCH_NO
 WHERE CTR.COMPANY_CODE = $P{P_KEY_PARAM1}
   AND CTR.DIVISION_CODE = $P{P_KEY_PARAM2}
   AND CTR.PRESENTN_NO = $P{P_KEY_PARAM3}
 ORDER BY CTR.SEQ]]>
		</queryString>
		<field name="SEQ" class="java.math.BigDecimal"/>
		<field name="RAWMTRL_CODE" class="java.lang.String"/>
		<field name="ITEM_NM" class="java.lang.String"/>
		<field name="GOODS_BRAND" class="java.lang.String"/>
		<field name="ORGIN_NATION_CODE" class="java.lang.String"/>
		<field name="RAWMTRL_SE" class="java.lang.String"/>
		<field name="IMPDEC_NO" class="java.lang.String"/>
		<field name="LNE_NO" class="java.math.BigDecimal"/>
		<field name="POUCH_NO" class="java.math.BigDecimal"/>
		<field name="ACPT_DATE" class="java.lang.String"/>
		<field name="DATE_EX" class="java.lang.String"/>
		<field name="USGQTY" class="java.math.BigDecimal"/>
		<field name="BASS_UNIT" class="java.lang.String"/>
		<field name="PO_AMOUNT" class="java.math.BigDecimal"/>
		<field name="CSTMS" class="java.lang.String"/>
		<field name="INTTAX" class="java.lang.String"/>
		<field name="TRANTAX" class="java.lang.String"/>
		<field name="LQTX_AMOUNT" class="java.lang.String"/>
		<field name="ECX_AMOUNT" class="java.lang.String"/>
		<field name="AGSPT" class="java.lang.String"/>
		<field name="DRWBAK_AMOUNT" class="java.lang.String"/>
		<field name="BASIS_DOC_NO" class="java.lang.String"/>
	</subDataset>
	<parameter name="P_KEY_PARAM1" class="java.lang.String"/>
	<parameter name="P_KEY_PARAM2" class="java.lang.String"/>
	<parameter name="P_KEY_PARAM3" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CC.PRESENTN_NO --제출번호
      -- 1. 신청내역
      ,CC.REGIST_RCEPT_NO --접수번호
      ,TO_CHAR(TO_DATE(CC.CHIT_FRMTRM_DATE, 'YYYYMMDD'), 'YYYY-MM-DD') CHIT_FRMTRM_DATE--접수일
      ,NVL(CC.CSTBRKR,' ') CSTBRKR --관세사상호
      ,NVL(CC.CSTBRKR_CODE,' ') CSTBRKR_CODE --관세사부호
      ,CC.DRWBAK_SE_CODE --환급구분코드
      ,CC.DRWBAK_SE --환급구분
      ,CC.REQREQY_CALC_MTH --소요량구분코드
      ,CC.REQREQY_CALC_NM --소요량구분
      -- 2. 양도자
      --상호
      --성명
      ,CC.BIZRNO --사업자번호
      --주소
      ,CC.ECTMRK --통관고유부호
      ,CC.TELNO_1
      -- 3. 양수자
      ,CC.CSTMR_NM_1 --상호
      ,CC.RPRSNTV_NM_1 --성명
      ,CC.CSTMR_BIZRNO --사업자번호
      ,CC.CSTMR_ADRES_1 --주소
      ,CC.CSTMR_ECTMRK --통관고유부호
      -- 4. 양도물품 내역
      ,MAX(CTR.RAWMTRL_CODE) AS RAWMTRL_CODE --품목번호
      ,MAX(TO_CHAR(TO_DATE(CTR.CHIT_FRMTRM_DATE, 'YYYYMMDD'), 'YYYY-MM-DD')) AS CHIT_FRMTRM_DATE --양도일자
      ,TO_CHAR(TO_DATE(CC.DATE_EX, 'YYYYMMDD'), 'YYYY-MM-DD') DATE_EX --수출이행기준일자
      ,TRIM(TO_CHAR(CC.ACCMLT_ORDER_QY,'999,999,990.99')) ACCMLT_ORDER_QY --총물량
      ,CC.BASS_UNIT --단위
      ,TRIM(TO_CHAR(TRUNC(CC.STTEMNT_PC_KRW,0),'999,999,990')) STTEMNT_PC_KRW --공급가격
      -- 5. 양도세액
      ,TRIM(TO_CHAR(TRUNC(CC.CSTMS,0),'999,999,990')) CSTMS --관세
      ,TRIM(TO_CHAR(TRUNC(CC.INTTAX,0),'999,999,990')) INTTAX --개별소비세
      ,TRIM(TO_CHAR(TRUNC(CC.TRANTAX,0),'999,999,990')) TRANTAX --교통세
      ,TRIM(TO_CHAR(TRUNC(CC.LQTX_AMOUNT,0),'999,999,990')) LQTX_AMOUNT --주세
      ,TRIM(TO_CHAR(TRUNC(CC.ECX_AMOUNT,0),'999,999,990')) ECX_AMOUNT --교육세
      ,TRIM(TO_CHAR(TRUNC(CC.AGSPT,0),'999,999,990')) AGSPT --농특세
      ,TRIM(TO_CHAR(TRUNC(CC.CSTMS + CC.INTTAX + CC.TRANTAX + CC.LQTX_AMOUNT + CC.ECX_AMOUNT + CC.AGSPT,0),'999,999,990')) SUM_AMOUNT --합계
      -- 6. 신청처리내역
      ,CC.CSMHSE_CODE --세관코드
      ,CC.CSMHSE_TEXT --세관
      --증명일자
      --담당자코드
      --담당자
  FROM CTRM_CMMN CC
 INNER JOIN CTRM_THING_RAWMTRL CTR
    ON CTR.COMPANY_CODE = CC.COMPANY_CODE
   AND CTR.DIVISION_CODE = CC.DIVISION_CODE
   AND CTR.PRESENTN_NO = CC.PRESENTN_NO
 WHERE CC.COMPANY_CODE = $P{P_KEY_PARAM1}
   AND CC.DIVISION_CODE = $P{P_KEY_PARAM2}
   AND CC.PRESENTN_NO = $P{P_KEY_PARAM3}
 GROUP BY CC.PRESENTN_NO
      ,CC.REGIST_RCEPT_NO
      ,CC.CHIT_FRMTRM_DATE
      ,CC.CSTBRKR
      ,CC.CSTBRKR_CODE
      ,CC.DRWBAK_SE_CODE
      ,CC.DRWBAK_SE
      ,CC.REQREQY_CALC_MTH
      ,CC.REQREQY_CALC_NM
      --상호
      --성명
      ,CC.BIZRNO
      --주소
      ,CC.ECTMRK
      ,CC.TELNO_1
      ,CC.CSTMR_NM_1
      ,CC.RPRSNTV_NM_1
      ,CC.CSTMR_BIZRNO
      ,CC.CSTMR_ADRES_1
      ,CC.CSTMR_ECTMRK
      ,TO_CHAR(TO_DATE(CC.DATE_EX, 'YYYYMMDD'), 'YYYY-MM-DD')
      ,CC.ACCMLT_ORDER_QY
      ,CC.BASS_UNIT
      ,CC.STTEMNT_PC_KRW
      ,CC.CSTMS
      ,CC.INTTAX
      ,CC.TRANTAX
      ,CC.LQTX_AMOUNT
      ,CC.ECX_AMOUNT
      ,CC.AGSPT
      ,CC.CSMHSE_CODE
      ,CC.CSMHSE_TEXT
      --증명일자]]>
	</queryString>
	<field name="PRESENTN_NO" class="java.lang.String"/>
	<field name="REGIST_RCEPT_NO" class="java.lang.String"/>
	<field name="CHIT_FRMTRM_DATE" class="java.lang.String"/>
