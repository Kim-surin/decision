	<subDataset name="New Dataset 1" uuid="9961ada9-7efc-4262-a229-691808e364bf">
		<parameter name="P_COMPANY_CODE" class="java.lang.String"/>
		<parameter name="P_KEY_PARAM1" class="java.lang.String"/>
		<parameter name="P_KEY_PARAM2" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT LPAD(ROWNUM, 4, '0') AS RNUM,
       COMPANY_CODE,
       PRESENTN_NO,
       THNG_SEQ,
       ITEM_CODE,
       ITEM_NM,
       THNG_SE,
       XPORT_STTEMNT_NO,
       LNE_NO,
       POUCH_NO,
       DSPTH_DATE,
       ACCMLT_ORDER_QY,
       BASS_UNIT,
       STTEMNT_PC_KRW,
       KRW_CRNCY,
       DIVISION_CODE,
       CREATE_DATE
  FROM (SELECT DISTINCT COMPANY_CODE,
                        PRESENTN_NO,
                        THNG_SEQ,
                        ITEM_CODE,
                        ITEM_NM,
                        THNG_SE,
                        XPORT_STTEMNT_NO,
                        LNE_NO,
                        POUCH_NO,
                        DSPTH_DATE,
                        ACCMLT_ORDER_QY,
                        BASS_UNIT,
                        STTEMNT_PC_KRW,
                        KRW_CRNCY,
                        DIVISION_CODE,
                        CREATE_DATE
          FROM (SELECT T.COMPANY_CODE,
                       T.PRESENTN_NO,
                       T.THNG_SEQ,
                       T.ITEM_CODE,
                       T.ITEM_NM,
                       T.THNG_SE,
                       T.XPORT_STTEMNT_NO,
                       T.LNE_NO,
                       T.POUCH_NO,
                       TO_CHAR(TO_DATE(T.DSPTH_DATE, 'YYYYMMDD'),
                               'YYYY-MM-DD') AS DSPTH_DATE,
                       TO_CHAR(TRUNC(T.ACCMLT_ORDER_QY),
                               'FM999,999,999,999,999') AS ACCMLT_ORDER_QY,
                       T.BASS_UNIT,
                       TO_CHAR(TRUNC(T.STTEMNT_PC_KRW),
                               'FM999,999,999,999,999') AS STTEMNT_PC_KRW,
                       T.KRW_CRNCY,
                       T.DIVISION_CODE,
                       T.CREATE_DATE,
                       CASE WHEN B.IMP_BASS_UNIT = A.BASS_UNIT THEN A.USGQTY
                              ELSE (CASE WHEN B.IMP_BASS_UNIT = 'KG' THEN A.USGQTY / 1000
                                         WHEN B.IMP_BASS_UNIT = 'LB' THEN A.USGQTY / 0.453592 / 1000
                                         WHEN B.IMP_BASS_UNIT = 'DR' THEN A.USGQTY / 1000 / 30
                                         WHEN B.IMP_BASS_UNIT = 'GR' THEN A.USGQTY / 0.064799
                                         WHEN B.IMP_BASS_UNIT = 'MT' THEN A.USGQTY / 1000 / 1000
                                         ELSE B.QY END)
                         END AS USGQTY
                  FROM DRWBAK_REQSTDOC_TRGET_THNG T
                 INNER JOIN DRWBAK_REQSTDOC_INCME_RAWMTRL A
                    ON T.COMPANY_CODE = A.COMPANY_CODE
                   AND T.PRESENTN_NO = A.PRESENTN_NO
                   AND T.THNG_SEQ = A.THNG_SEQ
                 INNER JOIN INCME_LOCAL_BNT_SM B
                    ON A.COMPANY_CODE = B.COMPANY_CODE
                   AND A.RAWMTRL_CODE = B.ITEM_CODE
                   AND A.LNE_NO = B.LNE_NO
                   AND A.POUCH_NO = B.POUCH_NO
                   AND A.IMPDEC_NO = B.IMPDEC_NO
                 INNER JOIN IMPDEC_CERFIN_ITEM C
                    ON A.COMPANY_CODE = C.COMPANY_CODE
                   AND A.RAWMTRL_CODE = C.ITEM_CODE
                   AND A.LNE_NO = C.LNE_NO
                   AND A.POUCH_NO = C.POUCH_NO
                   AND A.IMPDEC_NO = C.IMPDEC_NO
                 WHERE TRUNC(A.CSTMS, 4) > 0
                   AND T.COMPANY_CODE = $P{P_COMPANY_CODE}
                   AND T.DIVISION_CODE = $P{P_KEY_PARAM2}
                   AND T.PRESENTN_NO = $P{P_KEY_PARAM1}) X
         WHERE TRUNC(USGQTY, 3) > 0.000999999999999
        ORDER BY X.XPORT_STTEMNT_NO, X.LNE_NO, X.POUCH_NO)]]>
		</queryString>
		<field name="RNUM" class="java.lang.String"/>
		<field name="COMPANY_CODE" class="java.lang.String"/>
		<field name="PRESENTN_NO" class="java.lang.String"/>
		<field name="THNG_SEQ" class="java.math.BigDecimal"/>
		<field name="ITEM_CODE" class="java.lang.String"/>
		<field name="ITEM_NM" class="java.lang.String"/>
		<field name="THNG_SE" class="java.lang.String"/>
		<field name="XPORT_STTEMNT_NO" class="java.lang.String"/>
		<field name="LNE_NO" class="java.math.BigDecimal"/>
		<field name="POUCH_NO" class="java.math.BigDecimal"/>
		<field name="DSPTH_DATE" class="java.lang.String"/>
		<field name="ACCMLT_ORDER_QY" class="java.lang.String"/>
		<field name="BASS_UNIT" class="java.lang.String"/>
		<field name="STTEMNT_PC_KRW" class="java.lang.String"/>
		<field name="KRW_CRNCY" class="java.lang.String"/>
		<field name="DIVISION_CODE" class="java.lang.String"/>
		<field name="CREATE_DATE" class="java.sql.Timestamp"/>
	</subDataset>
	<subDataset name="New Dataset 2" uuid="5ce52b62-054d-4444-abf7-4fdb1c99d3c0">
		<parameter name="P_COMPANY_CODE" class="java.lang.String"/>
		<parameter name="P_KEY_PARAM1" class="java.lang.String"/>
		<parameter name="P_KEY_PARAM2" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT LPAD(ROWNUM, 5, '0') AS RNUM,
       COMPANY_CODE,
       PRESENTN_NO,
       THNG_SEQ,
       RAWMTRL_SEQ,
       ITEM_CODE,
       RAWMTRL_CODE,
       ITEM_NM,
       HS_CODE,
       RAWMTRL_SE,
       IMPDEC_NO,
       LNE_NO,
       POUCH_NO,
       ACPT_DATE,
       TRUNC(USGQTY,3) AS USGQTY,
       BASS_UNIT,
       TO_CHAR(TRUNC(CSTMS), 'FM999,999,999,999,999') AS CSTMS,
       TO_CHAR(TRUNC(INTTAX), 'FM999,999,999,999,999') AS INTTAX,
       TO_CHAR(TRUNC(ECX_AMOUNT), 'FM999,999,999,999,999') AS ECX_AMOUNT,
       TO_CHAR(TRUNC(AGSPT), 'FM999,999,999,999,999') AS AGSPT ,
       DDC_RATE_PRDCTN,
       TO_CHAR(TRUNC(DRWBAK_AMOUNT), 'FM999,999,999,999,999') AS DRWBAK_AMOUNT,
       ACPLC_CRNCY,
       TRGET_AT,
       BY_PRODUCT_SE,
       TO_CHAR(TRUNC(TRANTAX), 'FM999,999,999,999,999') AS TRANTAX,
       TO_CHAR(TRUNC(LQTX_AMOUNT), 'FM999,999,999,999,999') AS LQTX_AMOUNT,
       TO_CHAR(TRUNC(TAX_SUM), 'FM999,999,999,999,999') AS TAX_SUM,
       DDC_RATE_PRDCTN_YN,
       FMT_HS_CODE,
       EFECT_BGNDE,
       TO_CHAR(TRUNC(UNIT_PRICE), 'FM999,999,999,999,999') AS UNIT_PRICE
  FROM (

        SELECT

         A.COMPANY_CODE,
          A.PRESENTN_NO,
          A.THNG_SEQ,
          A.RAWMTRL_SEQ,
          A.ITEM_CODE,
          A.RAWMTRL_CODE,
          A.ITEM_NM,
          A.HS_CODE,
          A.RAWMTRL_SE,
          A.IMPDEC_NO,
          LPAD(A.LNE_NO, '3','0') AS LNE_NO,
          LPAD(A.POUCH_NO, '2', '0') AS POUCH_NO,
          A.ACPT_DATE,
          (CASE
            WHEN B.IMP_BASS_UNIT = A.BASS_UNIT THEN
             A.USGQTY
            ELSE
             (CASE
               WHEN B.IMP_BASS_UNIT = 'KG' THEN
                A.USGQTY / 1000
               WHEN B.IMP_BASS_UNIT = 'LB' THEN
                A.USGQTY / 0.453592 / 1000
               WHEN B.IMP_BASS_UNIT = 'DR' THEN
                A.USGQTY / 1000 / 30
               WHEN B.IMP_BASS_UNIT = 'GR' THEN
                A.USGQTY / 0.064799
               WHEN B.IMP_BASS_UNIT = 'MT' THEN
                A.USGQTY / 1000 / 1000
               ELSE
                B.QY
             END)
          END) AS USGQTY,
          B.IMP_BASS_UNIT AS BASS_UNIT,
          A.CSTMS,
          A.INTTAX,
          A.ECX_AMOUNT,
          A.AGSPT,
          NVL(A.DDC_RATE_PRDCTN, 0) AS DDC_RATE_PRDCTN,
          TRUNC(A.DRWBAK_AMOUNT) AS DRWBAK_AMOUNT,
          A.ACPLC_CRNCY,
          A.TRGET_AT,
          A.BY_PRODUCT_SE,
          A.TRANTAX,
          A.LQTX_AMOUNT,
          TRUNC(A.CSTMS + A.INTTAX + A.ECX_AMOUNT + A.AGSPT + A.TRANTAX +
          A.LQTX_AMOUNT) AS TAX_SUM,
          CASE
            WHEN A.DDC_RATE_PRDCTN = 0 OR DDC_RATE_PRDCTN IS NULL THEN
             ' N'
            ELSE
             'Y'
          END AS DDC_RATE_PRDCTN_YN,
          SUBSTR(B.HS_CODE, 1, 4) || '.' || SUBSTR(B.HS_CODE, 5, 2) || '-' ||
          SUBSTR(B.HS_CODE, 7, 4) AS FMT_HS_CODE,
          TO_CHAR(TO_DATE(B.EFECT_BGNDE, 'RRRRMMDD'), 'RRRR-MM-DD') AS EFECT_BGNDE,
          C.UNIT_PRICE

          FROM DRWBAK_REQSTDOC_INCME_RAWMTRL A
         INNER JOIN INCME_LOCAL_BNT_SM B
            ON A.COMPANY_CODE = B.COMPANY_CODE
           AND A.RAWMTRL_CODE = B.ITEM_CODE
           AND A.LNE_NO = B.LNE_NO
           AND A.POUCH_NO = B.POUCH_NO
           AND A.IMPDEC_NO = B.IMPDEC_NO
         INNER JOIN IMPDEC_CERFIN_ITEM C
            ON A.COMPANY_CODE = C.COMPANY_CODE
           AND A.RAWMTRL_CODE = C.ITEM_CODE
           AND A.LNE_NO = C.LNE_NO
           AND A.POUCH_NO = C.POUCH_NO
           AND A.IMPDEC_NO = C.IMPDEC_NO
         WHERE TRUNC(A.CSTMS, 4) > 0
           AND A.COMPANY_CODE =  $P{P_COMPANY_CODE}
           AND A.PRESENTN_NO = $P{P_KEY_PARAM1}
         ORDER BY THNG_SEQ, RAWMTRL_SEQ)
 WHERE TRUNC(USGQTY, 3) > 0.000999999999999]]>
		</queryString>
		<field name="RNUM" class="java.lang.String"/>
		<field name="COMPANY_CODE" class="java.lang.String"/>
		<field name="PRESENTN_NO" class="java.lang.String"/>
		<field name="THNG_SEQ" class="java.math.BigDecimal"/>
		<field name="RAWMTRL_SEQ" class="java.math.BigDecimal"/>
		<field name="ITEM_CODE" class="java.lang.String"/>
		<field name="RAWMTRL_CODE" class="java.lang.String"/>
		<field name="ITEM_NM" class="java.lang.String"/>
		<field name="HS_CODE" class="java.lang.String"/>
		<field name="RAWMTRL_SE" class="java.lang.String"/>
		<field name="IMPDEC_NO" class="java.lang.String"/>
		<field name="LNE_NO" class="java.lang.String"/>
		<field name="POUCH_NO" class="java.lang.String"/>
		<field name="ACPT_DATE" class="java.lang.String"/>
		<field name="USGQTY" class="java.math.BigDecimal"/>
		<field name="BASS_UNIT" class="java.lang.String"/>
		<field name="CSTMS" class="java.lang.String"/>
		<field name="INTTAX" class="java.lang.String"/>
		<field name="ECX_AMOUNT" class="java.lang.String"/>
		<field name="AGSPT" class="java.lang.String"/>
		<field name="DDC_RATE_PRDCTN" class="java.math.BigDecimal"/>
		<field name="DRWBAK_AMOUNT" class="java.lang.String"/>
		<field name="ACPLC_CRNCY" class="java.lang.String"/>
		<field name="TRGET_AT" class="java.lang.String"/>
		<field name="BY_PRODUCT_SE" class="java.lang.String"/>
		<field name="TRANTAX" class="java.lang.String"/>
		<field name="LQTX_AMOUNT" class="java.lang.String"/>
		<field name="TAX_SUM" class="java.lang.String"/>
		<field name="DDC_RATE_PRDCTN_YN" class="java.lang.String"/>
		<field name="FMT_HS_CODE" class="java.lang.String"/>
		<field name="EFECT_BGNDE" class="java.lang.String"/>
		<field name="UNIT_PRICE" class="java.lang.String"/>
	</subDataset>
	<subDataset name="New Dataset 3" uuid="6325ee96-b41e-401b-a4b8-82e6f3a8da34">
