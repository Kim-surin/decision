	<subDataset name="New Dataset 4" uuid="920e44a5-462f-4330-a74c-01b934354241">
		<parameter name="P_COMPANY" class="java.lang.String"/>
		<parameter name="KEY_PARAM1" class="java.lang.String"/>
		<field name="field1" class="java.lang.String"/>
		<field name="field2" class="java.lang.String"/>
		<field name="field3" class="java.lang.String"/>
		<field name="field4" class="java.lang.String"/>
		<field name="field5" class="java.lang.String"/>
		<field name="field6" class="java.lang.String"/>
		<field name="field7" class="java.lang.String"/>
		<field name="field8" class="java.lang.String"/>
		<field name="field9" class="java.lang.String"/>
		<field name="field10" class="java.lang.String"/>
		<field name="field11" class="java.lang.String"/>
		<field name="field12" class="java.lang.String"/>
		<field name="field13" class="java.lang.String"/>
	</subDataset>
	<parameter name="P_COMPANY_CODE" class="java.lang.String"/>
	<parameter name="P_KEY_PARAM1" class="java.lang.String"/>
	<parameter name="P_KEY_PARAM2" class="java.lang.String"/>
	<parameter name="P_REGIST_RCEPT_NO" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT SUBMIT_NO AS SUBMIT_NO,
       $P{P_REGIST_RCEPT_NO} AS PRESENTN_NO,
       COMPANY_CODE,
       REGIST_RCEPT_NO,
       EXECUT_AT,
       STTEMNT_DOC_STLE,
       DRWBAK_SE_CODE,
       DRWBAK_SE,
       XPORT_TYPE,
       CSMHSE_CODE,
       CSMHSE_TEXT,
       ACNUTNO,
       BANK_CODE,
       ECTMRK,
       BIZRNO,
       TELNO_1,
       CSTBRKR,
       HS_CODE,
       NATION_CODE,
       REQREQY_CALC_MTH,
       BOM_TYPE,
       ITEM_NM,
       STTEMNT_PC_KRW,
       KRW_CRNCY,
       ACCMLT_ORDER_QY,
       BASS_UNIT,
       CSTMS,
       INTTAX,
       ECX_AMOUNT,
       AGSPT,
       DRWBAK_AMOUNT,
       ACPLC_CRNCY,
       TRNSMIS_ID,
       LF_PRICE_TRGT,
       TAX_RATE_TRGT,
       DIVISION_CODE,
       DRWBAK_COMP_DATE,
       DRWBAK_MONTH,
       MANUFAC_NAME,
       DRWBAK_REQ_DATE,
       TRANTAX,
       LQTX_AMOUNT,
       DIVISION_NAME,
       REGIST_ADDRESS,
       RPRSNTV_NM,
       BANK_NM,
       V_BIZRNO,
       V_ECTMRK,
       V_RPRSNTV_NM,
       V_ADRES,
       MS_ITEM_NM,
       MS_ITEM_CODE,
       MS_BASS_UNIT,
       MS_STTEMNT_PC_KRW,
       CASE WHEN MS_NATION_CODE IN ('CN' ,'EU' ,'US') THEN MS_NATION_CODE
            ELSE 'ZZ' END AS MS_NATION_CODE
  FROM (SELECT DISTINCT A.COMPANY_CODE,
                        P.PRESENTN_NO,
                        A.SUBMIT_NO,
                        NVL(A.REGIST_RCEPT_NO, ' ') AS REGIST_RCEPT_NO,
                        NVL(A.EXECUT_AT, ' ') AS EXECUT_AT,
                        A.STTEMNT_DOC_STLE,
                        A.DRWBAK_SE_CODE,
                        '[' || A.DRWBAK_SE_CODE || '] ' || A.DRWBAK_SE AS DRWBAK_SE,
                        A.XPORT_TYPE,
                        A.CSMHSE_CODE,
                        A.CSMHSE_TEXT,
                        A.ACNUTNO,
                        A.BANK_CODE,
                        A.ECTMRK,
                        SUBSTR(A.BIZRNO, 1, 3) || '-' || SUBSTR(A.BIZRNO, 4, 2) || '-' || SUBSTR(A.BIZRNO, 6, 5) AS BIZRNO,
                        '010-6694-7707' AS TELNO_1, -- 안희준관세사
                        NVL(A.CSTBRKR, ' ') AS CSTBRKR,
                        SUBSTR(A.HS_CODE, 1, 4) || '.' ||
                        SUBSTR(A.HS_CODE, 5, 2) || '-' ||
                        SUBSTR(A.HS_CODE, 7, 4) AS HS_CODE,
                        A.NATION_CODE,
                        '[' || A.REQREQY_CALC_MTH || '] ' || A.BOM_TYPE AS REQREQY_CALC_MTH,
                        A.BOM_TYPE,
                        A.ITEM_NM,
                        TO_CHAR(TRUNC(A.STTEMNT_PC_KRW),
                                'FM999,999,999,999,999,999') AS STTEMNT_PC_KRW,
                        A.KRW_CRNCY,
                        A.ACCMLT_ORDER_QY,
                        A.BASS_UNIT,
                        TO_CHAR(TRUNC(A.CSTMS, -1),
                                'FM999,999,999,999,999,999') AS CSTMS,
                        TO_CHAR(TRUNC(A.INTTAX, -1),
                                'FM999,999,999,999,999,999') AS INTTAX,
                        TO_CHAR(TRUNC(A.ECX_AMOUNT, -1),
                                'FM999,999,999,999,999,999') AS ECX_AMOUNT,
                        TO_CHAR(TRUNC(A.AGSPT, -1),
                                'FM999,999,999,999,999,999') AS AGSPT,
                        /* 환급 총액 별도 계산 */
                        TO_CHAR(TRUNC(( SELECT TRUNC(SUM(TAX_SUM), -1)
                                          FROM (SELECT
                                                  (CASE
                                                    WHEN B.IMP_BASS_UNIT = A.BASS_UNIT THEN   A.USGQTY
                                                    ELSE
                                                     (CASE   WHEN B.IMP_BASS_UNIT = 'KG' THEN A.USGQTY / 1000
                                                             WHEN B.IMP_BASS_UNIT = 'LB' THEN A.USGQTY / 0.453592 / 1000
                                                             WHEN B.IMP_BASS_UNIT = 'DR' THEN A.USGQTY / 1000 / 30
                                                             WHEN B.IMP_BASS_UNIT = 'GR' THEN A.USGQTY / 0.064799
                                                             WHEN B.IMP_BASS_UNIT = 'MT' THEN A.USGQTY / 1000 / 1000
                                                             ELSE B.QY
                                                         END)
                                                  END) AS USGQTY,
                                                  TRUNC(A.CSTMS + A.INTTAX + A.ECX_AMOUNT + A.AGSPT + A.TRANTAX + A.LQTX_AMOUNT) AS TAX_SUM
                                                  FROM DRWBAK_REQSTDOC_INCME_RAWMTRL A
                                                 INNER JOIN INCME_LOCAL_BNT_SM B
                                                    ON A.COMPANY_CODE = B.COMPANY_CODE
                                                   AND A.RAWMTRL_CODE = B.ITEM_CODE
                                                   AND A.LNE_NO = B.LNE_NO
                                                   AND A.POUCH_NO = B.POUCH_NO
                                                   AND A.IMPDEC_NO = B.IMPDEC_NO
                                                 INNER JOIN IMPDEC_CERFIN_ITEM C
                                                    ON A.COMPANY_CODE = C.COMPANY_CODE
                                                   AND A.RAWMTRL_CODE = C.ITEM_CODE
                                                   AND A.LNE_NO = C.LNE_NO
                                                   AND A.POUCH_NO = C.POUCH_NO
                                                   AND A.IMPDEC_NO = C.IMPDEC_NO
                                                 WHERE TRUNC(A.CSTMS, 4) > 0
                                                   AND A.COMPANY_CODE = $P{P_COMPANY_CODE}
                                                   AND A.PRESENTN_NO = $P{P_KEY_PARAM1}
                                                   )
                                         WHERE TRUNC(USGQTY, 3) > 0.000999999999999), -1), 'FM999,999,999,999,999,999') AS DRWBAK_AMOUNT,
                        A.ACPLC_CRNCY,
                        A.TRNSMIS_ID,
                        A.LF_PRICE_TRGT,
                        A.TAX_RATE_TRGT,
                        A.DIVISION_CODE,
                        A.DRWBAK_COMP_DATE,
                        A.DRWBAK_MONTH,
                        CASE
                          WHEN A.MANUFAC_NAME = '미상' THEN
                           '제조미상'
                          ELSE
                           A.MANUFAC_NAME
                        END MANUFAC_NAME,
                        A.DRWBAK_REQ_DATE,
                        A.TRANTAX,
                        A.LQTX_AMOUNT,
                        P.COMPANY_NM AS DIVISION_NAME,
                        P.ADRES AS REGIST_ADDRESS,
                        P.RPRSNTV_NM,
                        BM.BHF_NM AS BANK_NM,
                        CASE
                             WHEN A.MANUFAC_NAME = '미상' THEN  '000-00-00000'
                             WHEN A.MANUFAC_NAME LIKE '%아모레퍼시픽%' THEN SUBSTR(A.BIZRNO, 1, 3) || '-' || SUBSTR(A.BIZRNO, 4, 2) || '-' || SUBSTR(A.BIZRNO, 6, 5)
                             WHEN A.MANUFAC_NAME LIKE '%코스비젼%' THEN (SELECT
                                                                            SUBSTR(CC.BIZRNO, 1, 3) || '-' || SUBSTR(CC.BIZRNO, 4, 2) || '-' || SUBSTR(CC.BIZRNO, 6, 5)
                                                                       FROM COMPANY CC WHERE CC.COMPANY_NM LIKE '%코스비젼%' AND ROWNUM = 1)
                             ELSE V.BUSINESS_NO
                        END AS V_BIZRNO,
                        CASE
                             WHEN A.MANUFAC_NAME = '미상' THEN '제조미상9999000'
                             WHEN A.MANUFAC_NAME LIKE '%아모레퍼시픽%' THEN P.ECTMRK
                             WHEN A.MANUFAC_NAME LIKE '%코스비젼%' THEN (SELECT CC.ECTMRK FROM COMPANY CC WHERE CC.COMPANY_NM LIKE '%코스비젼%' AND ROWNUM = 1)
                             ELSE V.CUSTOM_UNQ_CODE
                        END AS V_ECTMRK,
                        CASE
                             WHEN A.MANUFAC_NAME = '미상' THEN ''
                             WHEN A.MANUFAC_NAME LIKE '%아모레퍼시픽%' THEN P.RPRSNTV_NM
                             WHEN A.MANUFAC_NAME LIKE '%코스비젼%' THEN (SELECT CC.RPRSNTV_NM FROM COMPANY CC WHERE CC.COMPANY_NM LIKE '%코스비젼%' AND ROWNUM = 1)
                             ELSE V.OFFICER_NAME
                        END AS V_RPRSNTV_NM,
                        CASE
                             WHEN A.MANUFAC_NAME = '미상' THEN ''
                             WHEN A.MANUFAC_NAME LIKE '%아모레퍼시픽%' THEN P.ADRES
                             WHEN A.MANUFAC_NAME LIKE '%코스비젼%' THEN (SELECT CC.RPRSNTV_NM FROM COMPANY CC WHERE CC.COMPANY_NM LIKE '%코스비젼%' AND ROWNUM = 1)
                             ELSE V.ADDRESS
                        END AS V_ADRES,
                        MAX(REQ.ITEM_NM) OVER() AS MS_ITEM_NM,
                        MAX(REQ.ITEM_CODE) OVER() AS MS_ITEM_CODE,
                        TO_CHAR(SUM(TRUNC(REQ.ACCMLT_ORDER_QY)) OVER(),
                                'FM999,999,999,999,999,999') || '(' ||
                        MAX(REQ.BASS_UNIT) OVER() || ')' AS MS_BASS_UNIT,
                        TO_CHAR(SUM(TRUNC(ECM.STTEMNT_PC_KRW)) OVER(),
                                'FM999,999,999,999,999,999') AS MS_STTEMNT_PC_KRW,
                        MAX(ECM.NATION_CODE) OVER() AS MS_NATION_CODE

  FROM DRWBAK_REQSTDOC_CMMN A
 INNER JOIN (SELECT DISTINCT COMPANY_CODE,
                              PRESENTN_NO,
                              THNG_SEQ,
                              ITEM_CODE,
                              ITEM_NM,
                              XPORT_STTEMNT_NO,
                              LNE_NO,
                              POUCH_NO,
                              ACCMLT_ORDER_QY,
                              BASS_UNIT,
                              STTEMNT_PC_KRW,
                              DIVISION_CODE,
                              CREATE_DATE
                FROM (SELECT T.COMPANY_CODE,
                             T.PRESENTN_NO,
                             T.THNG_SEQ,
                             T.ITEM_CODE,
                             T.ITEM_NM,
                             T.THNG_SE,
                             T.XPORT_STTEMNT_NO,
                             T.LNE_NO,
                             T.POUCH_NO,
                             TRUNC(T.ACCMLT_ORDER_QY) AS ACCMLT_ORDER_QY,
                             T.BASS_UNIT,
                             TRUNC(T.STTEMNT_PC_KRW) AS STTEMNT_PC_KRW,
                             T.KRW_CRNCY,
                             T.DIVISION_CODE,
                             T.CREATE_DATE,
                             CASE WHEN B.IMP_BASS_UNIT = A.BASS_UNIT THEN A.USGQTY
                                    ELSE (CASE WHEN B.IMP_BASS_UNIT = 'KG' THEN A.USGQTY / 1000
                                               WHEN B.IMP_BASS_UNIT = 'LB' THEN A.USGQTY / 0.453592 / 1000
                                               WHEN B.IMP_BASS_UNIT = 'DR' THEN A.USGQTY / 1000 / 30
                                               WHEN B.IMP_BASS_UNIT = 'GR' THEN A.USGQTY / 0.064799
                                               WHEN B.IMP_BASS_UNIT = 'MT' THEN A.USGQTY / 1000 / 1000
                                               ELSE B.QY END)
                               END AS USGQTY
                        FROM DRWBAK_REQSTDOC_TRGET_THNG T
                       INNER JOIN DRWBAK_REQSTDOC_INCME_RAWMTRL A
                          ON T.COMPANY_CODE = A.COMPANY_CODE
                         AND T.PRESENTN_NO = A.PRESENTN_NO
                         AND T.THNG_SEQ = A.THNG_SEQ
                       INNER JOIN INCME_LOCAL_BNT_SM B
                          ON A.COMPANY_CODE = B.COMPANY_CODE
                         AND A.RAWMTRL_CODE = B.ITEM_CODE
                         AND A.LNE_NO = B.LNE_NO
                         AND A.POUCH_NO = B.POUCH_NO
                         AND A.IMPDEC_NO = B.IMPDEC_NO
                       INNER JOIN IMPDEC_CERFIN_ITEM C
                          ON A.COMPANY_CODE = C.COMPANY_CODE
                         AND A.RAWMTRL_CODE = C.ITEM_CODE
                         AND A.LNE_NO = C.LNE_NO
                         AND A.POUCH_NO = C.POUCH_NO
                         AND A.IMPDEC_NO = C.IMPDEC_NO
                       WHERE TRUNC(A.CSTMS, 4) > 0
                         AND T.COMPANY_CODE = $P{P_COMPANY_CODE}
                         AND T.PRESENTN_NO = $P{P_KEY_PARAM1}
                         AND T.DIVISION_CODE = $P{P_KEY_PARAM2} ) X
               WHERE TRUNC(USGQTY, 3) > 0.000999999999999) REQ
    ON A.COMPANY_CODE = REQ.COMPANY_CODE
   AND A.DIVISION_CODE = REQ.DIVISION_CODE
   AND A.PRESENTN_NO = REQ.PRESENTN_NO
 INNER JOIN EXPORT_CERT_MST ECM
   ON REQ.COMPANY_CODE = ECM.COMPANY_CODE
  AND REQ.DIVISION_CODE = ECM.DIVISION_CODE
  AND REQ.XPORT_STTEMNT_NO = ECM.XPORT_STTEMNT_NO
  AND REQ.LNE_NO = ECM.LNE_NO
  AND REQ.POUCH_NO = ECM.POUCH_NO
  AND REQ.ITEM_CODE = ECM.ITEM_CODE
 INNER JOIN BANK_MST BM
    ON A.COMPANY_CODE = BM.COMPANY_CODE
   AND A.DIVISION_CODE = BM.DIVISION_CODE
   AND A.BANK_CODE = BM.BANK_CODE
 INNER JOIN COMPANY P
    ON A.COMPANY_CODE = P.COMPANY_CODE
  LEFT OUTER JOIN VENDOR V
    ON V.COMPANY_CODE = ECM.COMPANY_CODE
   AND V.VENDOR_CODE = ECM.VENDOR_CODE
 WHERE A.COMPANY_CODE = $P{P_COMPANY_CODE}
   AND A.PRESENTN_NO = $P{P_KEY_PARAM1}
   AND A.DIVISION_CODE = $P{P_KEY_PARAM2}  ) X]]>
	</queryString>
