				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="맑은 고딕" size="9" pdfFontName="/config/font/malgun.ttf" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{DRWBAK_SE}]]></textFieldExpression>
