	<field name="V_BIZRNO" class="java.lang.String"/>
	<field name="V_ECTMRK" class="java.lang.String"/>
	<field name="V_RPRSNTV_NM" class="java.lang.String"/>
	<field name="V_ADRES" class="java.lang.String"/>
	<field name="MS_ITEM_NM" class="java.lang.String"/>
