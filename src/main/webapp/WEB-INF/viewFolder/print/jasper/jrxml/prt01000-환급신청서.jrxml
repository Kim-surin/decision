	<field name="TAX_RATE_TRGT" class="java.lang.String"/>
	<field name="DIVISION_CODE" class="java.lang.String"/>
	<field name="DRWBAK_COMP_DATE" class="java.sql.Timestamp"/>
	<field name="DRWBAK_MONTH" class="java.lang.String"/>
