			<textField isBlankWhenNull="true">
				<reportElement x="588" y="82" width="70" height="28" uuid="e7059820-9a48-4b63-88e7-6fa9e18fa7e1"/>
				<box>
					<pen lineStyle="Dotted"/>
					<topPen lineWidth="0.34" lineStyle="Solid"/>
					<leftPen lineWidth="0.34" lineStyle="Dotted"/>
					<bottomPen lineWidth="0.34" lineStyle="Dotted"/>
