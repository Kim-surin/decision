<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0 //EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kpmg.kdb.web.common.CompanySettingDao">
	<!-- 레거시 FC01_GET_COMPANY_SETING_VALUE 대체 조회. 실제 테이블/컬럼명은 스키마 확인 후 보정 필요 -->
	<select id="selectSettingValue" parameterType="map" resultType="string">
		SELECT CS.SETTING_VALUE
		FROM   COMPANY_SETTING CS
		WHERE  CS.COMPANY_CODE = #{companyCode}
		AND    CS.SETTING_CODE = #{settingCode}
	</select>
</mapper>
