<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0 //EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kpmg.kdb.web.common.CompanySettingDao">
	<!-- 레거시 FC01_GET_COMPANY_SETING_VALUE 대체 조회. GET_BUFFER 의 OPTION_VALUE 조회와 동일한 COMPANY_OPTION 사용 -->
	<select id="selectSettingValue" parameterType="map" resultType="string">
		SELECT OPTION_VALUE
		FROM   COMPANY_OPTION
		WHERE  COMPANY_CODE = #{companyCode}
		AND    OPTION_CODE = #{settingCode}
	</select>
</mapper>
