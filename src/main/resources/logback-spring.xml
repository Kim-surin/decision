<?xml version="1.0" encoding="UTF-8"?>
<!-- 60초마다 설정 파일의 변경을 확인 하여 변경시 갱신 -->
<configuration scan="true" scanPeriod="60 seconds">

    <!-- pattern -->
    <property name="LOG_PATTERN" value="%-5level %d{yy-MM-dd HH:mm:ss}  [%logger:%line] - %msg%n"/>
    <!-- <property name="LOG_PATTERN" value="%-5level %d{yy-MM-dd HH:mm:ss}[%thread] [%logger{0}:%line] - %msg%n"/> -->

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- File Appender: 콘솔은 스크롤/뷰어 제한으로 긴 로그가 잘리므로, 같은 내용을 파일로도 남긴다.
         일자별로 쌓이도록 자정에 롤오버한다 - 오늘 로그는 logs/decision.log 에 계속 append 되고(앱을
         재시작해도 같은 날이면 이어서 쌓인다), 자정이 지나면 어제 분량이 logs/decision.2026-08-18.log
         형태로 이름이 바뀌어 보관되고 logs/decision.log 는 새로 시작한다. maxHistory 로 30일치만 보관
         하고 그 이전 파일은 자동 삭제한다(무한정 쌓이지 않도록). 경로는 앱 실행 시점의 작업
         디렉터리(working directory) 기준 상대경로다. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/decision.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/decision.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <logger level="OFF" appender-ref="CONSOLE" name="jdbc.sqltiming"/>
    <logger level="OFF" appender-ref="CONSOLE" name="jdbc.audit"/>
    <logger level="OFF" appender-ref="CONSOLE" name="jdbc.resultset"/>
    <logger level="OFF" appender-ref="CONSOLE" name="com.zaxxer.hikari.pool.PoolBase"/>
    <logger level="OFF" appender-ref="CONSOLE" name="com.zaxxer.hikari.pool.HikariPool"/>
    <logger level="OFF" appender-ref="CONSOLE" name="com.zaxxer.hikari.HikariDataSource"/>
    <logger name="org.springframework.jndi.JndiPropertySource" level="OFF"/>
    <logger name="org.mybatis.spring.SqlSessionUtils" level="OFF"/>
    <logger name="org.springframework.jdbc.datasource.DataSourceUtils" level="OFF"/>
    
    <logger name="com.zaxxer.hikari" level="OFF" />
	<logger name="com.zaxxer.hikari.HikariConfig" level="OFF"/>
	<logger name="jdbc.connection" level="OFF"/>

    <logger level="ERROR" appender-ref="CONSOLE" name="org.quartz.core.QuartzSchedulerThread"/>
    <logger level="OFF"   appender-ref="CONSOLE" name="org.springframework.boot.autoconfigure.logging.ConditionEvaluationReportLoggingListener"/>
    <logger level="OFF"   appender-ref="CONSOLE" name="org.springframework.context.annotation.ClassPathBeanDefinitionScanner"/>
    <logger level="OFF"   appender-ref="CONSOLE" name="org.springframework.beans.factory.support.DefaultListableBeanFactory"/>

    <!-- Context Binding hide -->
    <logger name="org.springframework.jndi.JndiTemplate" level="OFF"/>
    <logger name="org.springframework.jndi.JndiLocatorDelegate" level="OFF"/>
    
    <!-- SECURITY.WEB -->
    <logger name="org.springframework.security.web.FilterChainProxy" level="OFF"/>
    <logger name="org.springframework.web.servlet.DispatcherServlet" level="OFF"/>
    <logger name="org.springframework.web.servlet.handler.SimpleUrlHandlerMapping" level="OFF"/>
    <logger name="org.springframework.security.web.context.HttpSessionSecurityContextRepository" level="OFF"/>
    <logger name="org.springframework.jndi.JndiTemplate" level="OFF"/>
    <logger name="org.springframework.security.web.context.HttpSessionSecurityContextRepository" level="OFF"/>
	<logger name="org.springframework.security.web.context.SecurityContextPersistenceFilter" level="OFF"/>
	<logger name="org.springframework.security.web.authentication.AnonymousAuthenticationFilter" level="OFF"/>
	<logger name="org.springframework.security.web.access.intercept.FilterSecurityInterceptor" level="OFF"/>
    
    <!-- root레벨 설정 -->
    <root level="debug">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- 특정패키지 로깅레벨 설정 -->
    <logger name="org.apache.ibatis" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>
</configuration>